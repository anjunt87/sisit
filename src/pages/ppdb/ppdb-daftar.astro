---

<BaseLayout title="Daftar PPDB – NIIS">
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Tajawal:wght@300;400;500;700&display=swap"
    rel="stylesheet"
  />

  <div id="ppdb-daftar-page">
    <!-- ── Hero strip ── -->
    <div class="daftar-hero">
      <div class="daftar-hero__bg"></div>
      <div class="daftar-hero__inner">
        <!-- <a
          href="/ppdb"
          class="back-link"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path d="M19 12H5M12 19l-7-7 7-7"></path>
          </svg>
          Kembali ke PPDB
        </a> -->
        <div class="daftar-hero__text mt-7">
          <span class="daftar-eyebrow">
            Pendaftaran Peserta Didik Baru {TAHUN}
          </span>
          <h1 class="daftar-title">Pilih Jenjang<br /><em>Pendidikan</em></h1>
          <p class="daftar-sub">
            Pilih jenjang yang sesuai, lengkapi formulir, dan amankan tempat<br
              class="d-none d-md-block"
            /> sebelum kuota habis.
          </p>
        </div>
        <!-- Steps indicator -->
        <div class="steps-row">
          <div class="step step--active">
            <span class="step__num">1</span><span class="step__label">
              Pilih Jenjang
            </span>
          </div>
          <div class="step-line"></div>
          <div class="step">
            <span class="step__num">2</span><span class="step__label">
              Isi Formulir
            </span>
          </div>
          <div class="step-line"></div>
          <div class="step">
            <span class="step__num">3</span><span class="step__label">
              Upload Dokumen
            </span>
          </div>
          <div class="step-line"></div>
          <div class="step">
            <span class="step__num">4</span><span class="step__label">
              Konfirmasi
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Filter Tabs ── -->
    <div class="tabs-wrap">
      <div class="tabs-scroll">
        <div
          class="tabs"
          id="jenjang-tabs"
          role="tablist"
        >
          {
            jenjang.map((j, i) => (
              <button
                class={`tab-btn${i === 0 ? " tab-btn--active" : ""}`}
                role="tab"
                data-target={j.id}
                aria-selected={i === 0 ? "true" : "false"}
                style={`--tab-color:${j.color}`}
              >
                <span class="tab-icon">{j.icon}</span>
                <span class="tab-label">{j.label}</span>
                <span class="tab-sub">{j.nama}</span>
                <span
                  class="tab-kuota"
                  data-id={j.id}
                >
                  {j.kuota - j.terisi} sisa
                </span>
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <div
      class="cards-area"
      id="cards-area"
    >
      {
        jenjang.map((j, i) => {
          const pct = Math.round((j.terisi / j.kuota) * 100);
          const sisa = j.kuota - j.terisi;
          // Gunakan tanda kurung pada logika perbandingan agar tidak dianggap tag HTML
          const urgent = "sisa <= 10";

          return (
            <div
              class={`jenjang-card ${i === 0 ? "jenjang-card--visible" : ""}`}
              id={`card-${j.id}`}
              data-jenjang={j.id}
              style={`--card-color: ${j.color}`}
            >
              <div class="card-grid">
                {/* LEFT: info utama */}
                <div class="card-left">
                  <div class="card-header">
                    <div
                      class="card-icon-wrap"
                      style={`background:${j.color}18; border-color:${j.color}30`}
                    >
                      <span style="font-size:2rem;">{j.icon}</span>
                    </div>
                    <div>
                      <div
                        class="card-label"
                        style={`color:${j.color}`}
                      >
                        {j.label} · {j.usia}
                      </div>
                      <h2 class="card-nama">{j.nama}</h2>
                    </div>
                    {urgent && (
                      <div class="urgent-badge">
                        <span class="urgent-pulse" />
                        Kuota hampir habis!
                      </div>
                    )}
                  </div>

                  {/* Kuota progress */}
                  <div class="kuota-block">
                    <div class="kuota-row">
                      <span class="kuota-label">Kuota terisi</span>
                      <span
                        class="kuota-pct"
                        style={`color:${j.color}`}
                      >
                        {pct}%
                      </span>
                    </div>
                    <div class="kuota-bar-bg">
                      <div
                        class="kuota-bar-fill"
                        style={`width:${pct}%; background:${j.color}`}
                      />
                    </div>
                    <div class="kuota-detail">
                      <span>{j.terisi} pendaftar</span>
                      <span>
                        {sisa} kursi tersisa dari {j.kuota}
                      </span>
                    </div>
                  </div>

                  {/* Biaya */}
                  <div class="biaya-row">
                    <div class="biaya-item">
                      <span class="biaya-icon">📋</span>
                      <div>
                        <div class="biaya-label">Biaya Pendaftaran</div>
                        <div class="biaya-val">{j.biaya_pendaftaran}</div>
                      </div>
                    </div>
                    <div class="biaya-sep" />
                    <div class="biaya-item">
                      <span class="biaya-icon">📅</span>
                      <div>
                        <div class="biaya-label">SPP Bulanan</div>
                        <div class="biaya-val">{j.biaya_spp}</div>
                      </div>
                    </div>
                  </div>

                  {/* CTA */}
                  <div class="card-cta">
                    <a
                      href={`/ppdb/formulir?jenjang=${j.id}`}
                      class="btn-daftar"
                      style={`background:${j.color}`}
                    >
                      Daftar {j.label} Sekarang
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                      >
                        <path d="M5 12h14M12 5l7 7-7 7" />
                      </svg>
                    </a>
                    <a
                      href={`/ppdb/info?jenjang=${j.id}`}
                      class="btn-info"
                    >
                      Lihat Detail
                    </a>
                  </div>
                </div>

                {/* RIGHT: syarat + keunggulan */}
                <div class="card-right">
                  <div class="card-right-block">
                    <div class="block-title">
                      <svg
                        width="15"
                        height="15"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.2"
                      >
                        <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                      Syarat Dokumen
                    </div>
                    <ul class="checklist">
                      {j.syarat.map((s) => (
                        <li class="checklist__item">
                          <svg
                            width="13"
                            height="13"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke={j.color}
                            stroke-width="2.8"
                          >
                            <polyline points="20 6 9 17 4 12" />
                          </svg>
                          {s}
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class="card-right-block">
                    <div class="block-title">
                      <svg
                        width="15"
                        height="15"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.2"
                      >
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                      </svg>
                      Keunggulan Program
                    </div>
                    <ul class="checklist">
                      {j.keunggulan.map((k) => (
                        <li class="checklist__item">
                          <svg
                            width="13"
                            height="13"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke={j.color}
                            stroke-width="2.8"
                          >
                            <polyline points="20 6 9 17 4 12" />
                          </svg>
                          {k}
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class="trust-strip">
                    <div class="trust-item">
                      <span
                        class="trust-num"
                        style={`color:${j.color}`}
                      >
                        A
                      </span>
                      <span class="trust-label">Akreditasi</span>
                    </div>
                    <div class="trust-item">
                      <span
                        class="trust-num"
                        style={`color:${j.color}`}
                      >
                        15+
                      </span>
                      <span class="trust-label">Tahun</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>

    <!-- ── Bottom CTA strip ── -->
    <div class="bottom-strip">
      <div class="bottom-strip__inner">
        <div>
          <p class="bottom-strip__title">Masih ada pertanyaan?</p>
          <p class="bottom-strip__sub">
            Tim kami siap membantu Anda memilih jenjang yang tepat.
          </p>
        </div>
        <div class="bottom-strip__actions">
          <a
            href="https://wa.me/6281234567890"
            class="btn-wa"
            target="_blank"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
              >
              </path>
            </svg>
            WhatsApp Kami
          </a>
          <a
            href="/ppdb/konsultasi"
            class="btn-konsultasi"
          >
            Jadwalkan Konsultasi
          </a>
        </div>
      </div>
    </div>
  </div>

  <style>
    /* ── Reset & base ── */
    #ppdb-daftar-page {
      font-family: "Tajawal", sans-serif;
      background: #f0f4f1;
      min-height: 100vh;
    }

    /* ── Hero ── */
    .daftar-hero {
      position: relative;
      background: var(--green-deep, #1a3a2a);
      overflow: hidden;
      padding: 88px 24px 80px;
    }
    .daftar-hero__bg {
      position: absolute;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M30 0l8.66 15H21.34L30 0zm0 60l-8.66-15h17.32L30 60zM0 30l15-8.66v17.32L0 30zm60 0l-15 8.66V21.34L60 30zM30 22.5a7.5 7.5 0 1 1 0 15 7.5 7.5 0 0 1 0-15z'/%3E%3C/g%3E%3C/svg%3E");
    }
    .daftar-hero__inner {
      position: relative;
      max-width: 900px;
      margin: 0 auto;
    }
    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: rgba(255, 255, 255, 0.55);
      font-size: 0.82rem;
      text-decoration: none;
      margin-bottom: 32px;
      transition: color 0.2s;
    }
    .back-link:hover {
      color: #fff;
    }
    .daftar-eyebrow {
      display: block;
      font-size: 0.75rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--gold, #c9a84c);
      margin-bottom: 12px;
    }
    .daftar-title {
      font-family: "Playfair Display", serif;
      font-size: clamp(2rem, 5vw, 3.5rem);
      font-weight: 900;
      color: #fff;
      line-height: 1.1;
      margin: 0 0 16px;
    }
    .daftar-title em {
      font-style: italic;
      color: var(--gold, #c9a84c);
    }
    .daftar-sub {
      color: rgba(255, 255, 255, 0.6);
      font-size: 1rem;
      line-height: 1.7;
      margin: 0 0 40px;
    }

    /* Steps */
    .steps-row {
      display: flex;
      align-items: center;
      gap: 0;
      flex-wrap: wrap;
      gap: 4px;
    }
    .step {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      border-radius: 50px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .step--active {
      background: rgba(201, 168, 76, 0.15);
      border-color: rgba(201, 168, 76, 0.4);
    }
    .step__num {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.12);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.7rem;
      font-weight: 700;
      color: rgba(255, 255, 255, 0.5);
    }
    .step--active .step__num {
      background: var(--gold, #c9a84c);
      color: #1a3a2a;
    }
    .step__label {
      font-size: 0.78rem;
      color: rgba(255, 255, 255, 0.4);
    }
    .step--active .step__label {
      color: rgba(255, 255, 255, 0.85);
    }
    .step-line {
      flex: 1;
      max-width: 32px;
      height: 1px;
      background: rgba(255, 255, 255, 0.15);
    }

    /* ── Tabs ── */
    .tabs-wrap {
      background: #fff;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .tabs-scroll {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    .tabs-scroll::-webkit-scrollbar {
      display: none;
    }
    .tabs {
      display: flex;
      max-width: 900px;
      margin: 0 auto;
      padding: 0 16px;
    }
    .tab-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
      padding: 14px 28px 12px;
      border: none;
      background: transparent;
      cursor: pointer;
      border-bottom: 3px solid transparent;
      transition: all 0.2s;
      white-space: nowrap;
      position: relative;
      min-width: 100px;
    }
    .tab-btn:hover {
      background: rgba(0, 0, 0, 0.03);
    }
    .tab-btn--active {
      border-bottom-color: var(--tab-color);
      background: color-mix(in srgb, var(--tab-color) 6%, transparent);
    }
    .tab-icon {
      font-size: 1.3rem;
    }
    .tab-label {
      font-size: 0.85rem;
      font-weight: 700;
      color: #1a3a2a;
    }
    .tab-sub {
      font-size: 0.68rem;
      color: #888;
    }
    .tab-kuota {
      font-size: 0.62rem;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 20px;
      background: #f3f4f6;
      color: #555;
      margin-top: 2px;
    }
    .tab-btn--active .tab-kuota {
      background: color-mix(in srgb, var(--tab-color) 15%, transparent);
      color: var(--tab-color);
    }

    /* ── Cards area ── */
    .cards-area {
      max-width: 900px;
      margin: 0 auto;
      padding: 32px 16px 48px;
    }
    .jenjang-card {
      display: none;
      animation: fadeSlide 0.3s ease;
    }
    .jenjang-card--visible {
      display: block;
    }

    @keyframes fadeSlide {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .card-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
      background: #fff;
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 4px 32px rgba(0, 0, 0, 0.08);
      border: 1px solid rgba(0, 0, 0, 0.06);
    }

    /* Card Left */
    .card-left {
      padding: 36px 32px;
      border-right: 1px solid #f0f0f0;
    }
    .card-header {
      display: flex;
      align-items: flex-start;
      gap: 16px;
      margin-bottom: 28px;
      flex-wrap: wrap;
    }
    .card-icon-wrap {
      width: 56px;
      height: 56px;
      border-radius: 16px;
      border: 1px solid;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .card-label {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      margin-bottom: 4px;
    }
    .card-nama {
      font-family: "Playfair Display", serif;
      font-size: 1.5rem;
      font-weight: 700;
      color: #1a2a1f;
      margin: 0;
    }
    .urgent-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #fff3ed;
      border: 1px solid #fbbf7a;
      color: #d97706;
      font-size: 0.72rem;
      font-weight: 700;
      padding: 4px 12px;
      border-radius: 20px;
      margin-left: auto;
    }
    .urgent-pulse {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #f59e0b;
      animation: pulse-dot 1.2s ease-in-out infinite;
    }

    /* Kuota */
    .kuota-block {
      background: #f8faf9;
      border-radius: 14px;
      padding: 16px 18px;
      margin-bottom: 20px;
    }
    .kuota-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
    }
    .kuota-label {
      font-size: 0.78rem;
      color: #666;
    }
    .kuota-pct {
      font-family: "Playfair Display", serif;
      font-size: 1.2rem;
      font-weight: 700;
    }
    .kuota-bar-bg {
      background: #e8ede9;
      border-radius: 50px;
      height: 6px;
      overflow: hidden;
    }
    .kuota-bar-fill {
      height: 6px;
      border-radius: 50px;
      transition: width 0.8s ease 0.3s;
    }
    .kuota-detail {
      display: flex;
      justify-content: space-between;
      margin-top: 6px;
      font-size: 0.72rem;
      color: #888;
    }

    /* Biaya */
    .biaya-row {
      display: flex;
      align-items: center;
      gap: 0;
      background: #f8faf9;
      border-radius: 14px;
      overflow: hidden;
      margin-bottom: 24px;
    }
    .biaya-item {
      flex: 1;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 14px 18px;
    }
    .biaya-icon {
      font-size: 1.2rem;
    }
    .biaya-label {
      font-size: 0.7rem;
      color: #888;
      margin-bottom: 2px;
    }
    .biaya-val {
      font-size: 0.92rem;
      font-weight: 700;
      color: #1a2a1f;
    }
    .biaya-sep {
      width: 1px;
      background: #e8ede9;
      align-self: stretch;
    }

    /* CTA */
    .card-cta {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .btn-daftar {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      color: #fff;
      font-weight: 700;
      font-size: 1rem;
      padding: 16px 24px;
      border-radius: 14px;
      text-decoration: none;
      transition:
        filter 0.2s,
        transform 0.15s;
    }
    .btn-daftar:hover {
      filter: brightness(1.1);
      transform: translateY(-1px);
    }
    .btn-daftar svg {
      transition: transform 0.2s;
    }
    .btn-daftar:hover svg {
      transform: translateX(3px);
    }
    .btn-info {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      color: #556;
      font-size: 0.9rem;
      padding: 12px 24px;
      border-radius: 14px;
      text-decoration: none;
      border: 1.5px solid #e0e4e0;
      transition:
        border-color 0.2s,
        background 0.2s;
    }
    .btn-info:hover {
      border-color: var(--card-color);
      background: color-mix(in srgb, var(--card-color) 5%, transparent);
    }

    /* Card Right */
    .card-right {
      padding: 36px 32px;
      background: #fafcfb;
      display: flex;
      flex-direction: column;
      gap: 24px;
    }
    .card-right-block {
    }
    .block-title {
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #444;
      margin-bottom: 12px;
    }
    .checklist {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 7px;
    }
    .checklist__item {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.85rem;
      color: #333;
    }

    /* Trust strip */
    .trust-strip {
      display: flex;
      gap: 0;
      border: 1px solid #e8ede9;
      border-radius: 12px;
      overflow: hidden;
      margin-top: auto;
    }
    .trust-item {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 12px 8px;
      border-right: 1px solid #e8ede9;
      background: #fff;
    }
    .trust-item:last-child {
      border-right: none;
    }
    .trust-num {
      font-family: "Playfair Display", serif;
      font-size: 1.3rem;
      font-weight: 700;
    }
    .trust-label {
      font-size: 0.65rem;
      color: #888;
      text-align: center;
    }

    /* ── Bottom strip ── */
    .bottom-strip {
      background: var(--green-deep, #1a3a2a);
      padding: 36px 24px;
    }
    .bottom-strip__inner {
      max-width: 900px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      flex-wrap: wrap;
    }
    .bottom-strip__title {
      font-size: 1.1rem;
      font-weight: 700;
      color: #fff;
      margin: 0 0 4px;
    }
    .bottom-strip__sub {
      font-size: 0.85rem;
      color: rgba(255, 255, 255, 0.55);
      margin: 0;
    }
    .bottom-strip__actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }
    .btn-wa {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #25d366;
      color: #fff;
      font-weight: 700;
      font-size: 0.9rem;
      padding: 12px 24px;
      border-radius: 50px;
      text-decoration: none;
      transition: background 0.2s;
    }
    .btn-wa:hover {
      background: #1db954;
    }
    .btn-konsultasi {
      display: inline-flex;
      align-items: center;
      padding: 12px 24px;
      border-radius: 50px;
      border: 2px solid rgba(255, 255, 255, 0.25);
      color: #fff;
      font-size: 0.9rem;
      text-decoration: none;
      transition:
        border-color 0.2s,
        background 0.2s;
    }
    .btn-konsultasi:hover {
      border-color: var(--gold, #c9a84c);
      background: rgba(201, 168, 76, 0.1);
    }

    /* ── Responsive ── */
    @media (max-width: 700px) {
      .card-grid {
        grid-template-columns: 1fr;
      }
      .card-left {
        border-right: none;
        border-bottom: 1px solid #f0f0f0;
        padding: 24px 20px;
      }
      .card-right {
        padding: 24px 20px;
      }
      .steps-row {
        gap: 4px;
      }
      .step-line {
        display: none;
      }
      .daftar-title {
        font-size: 2rem;
      }
      .tab-btn {
        min-width: 80px;
        padding: 12px 16px 10px;
      }
    }
  </style>

  <script>
    const tabs = document.querySelectorAll<HTMLButtonElement>(".tab-btn");
    const cards = document.querySelectorAll<HTMLElement>(".jenjang-card");

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const target = tab.dataset.target;

        // Update tabs
        tabs.forEach((t) => {
          t.classList.remove("tab-btn--active");
          t.setAttribute("aria-selected", "false");
        });
        tab.classList.add("tab-btn--active");
        tab.setAttribute("aria-selected", "true");

        // Update cards
        cards.forEach((card) => {
          if (card.dataset.jenjang === target) {
            card.classList.add("jenjang-card--visible");
          } else {
            card.classList.remove("jenjang-card--visible");
          }
        });
      });
    });

    // Animate kuota bars on visibility
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const bar =
              entry.target.querySelector<HTMLElement>(".kuota-bar-fill");
            // width already set via inline style, just trigger a reflow
            if (bar) {
              const w = bar.style.width;
              bar.style.width = "0%";
              requestAnimationFrame(() => {
                bar.style.width = w;
              });
            }
          }
        });
      },
      { threshold: 0.2 },
    );

    cards.forEach((card) => observer.observe(card));
  </script>
</BaseLayout>
