---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/ppdb.css";
import Contact from "../components/landing/Contact.astro";

const PPDB_OPEN = "2026-01-01T00:00:00";
const PPDB_CLOSE = "2026-10-31T23:59:59";
const TAHUN = "2025/2026";
---

<BaseLayout title="PPDB">
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Tajawal:wght@400;500&display=swap"
    rel="stylesheet"
  />

  <section
    id="ppdb-banner"
    aria-label="Pengumuman PPDB"
  >
    <div
      class="relative overflow-hidden"
      style="background: var(--green-deep);"
    >
      <div class="absolute inset-0 islamic-bg"></div>

      <!-- Decorative circles -->
      <div class="deco-circle deco-circle--top"></div>
      <div class="deco-circle deco-circle--bottom"></div>

      <div class="ppdb-container">
        <!-- Top row: badge + tahun ajaran -->
        <div class="ppdb-toprow">
          <div
            id="ppdb-status-badge"
            class="status-badge badge-soon"
          >
            <div
              class="pulse-dot"
              id="ppdb-pulse"
              style="background:var(--gold);"
            >
            </div>
            <span id="ppdb-status-text">Memuat status...</span>
          </div>

          <div class="tahun-pill">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#c9a84c"
              stroke-width="2"
            >
              <rect
                x="3"
                y="4"
                width="18"
                height="18"
                rx="2"
              >
              </rect>
              <line
                x1="16"
                y1="2"
                x2="16"
                y2="6"
              >
              </line>
              <line
                x1="8"
                y1="2"
                x2="8"
                y2="6"
              >
              </line>
              <line
                x1="3"
                y1="10"
                x2="21"
                y2="10"
              >
              </line>
            </svg>
            <span class="tahun-label">
              Tahun Ajaran <strong style="color:#fff;">{TAHUN}</strong>
            </span>
          </div>
        </div>

        <!-- Main content grid -->
        <div class="ppdb-grid">
          <!-- Kiri: teks utama -->
          <div class="ppdb-left">
            <p class="ppdb-eyebrow">Penerimaan Peserta Didik Baru</p>
            <h2 class="ppdb-heading font-display">
              Daftarkan Putra–Putri Anda di NIIS
            </h2>
            <p class="ppdb-desc">
              Bergabunglah bersama ribuan keluarga yang telah mempercayakan
              pendidikan Islami terbaik kepada kami. Kuota terbatas — pastikan
              putra-putri Anda mendapatkan tempat.
            </p>

            <!-- Info items -->
            <div class="info-list">
              <div class="info-item">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="#52b788"
                  stroke-width="1.8"
                  style="margin-top:1px;flex-shrink:0;"
                >
                  <path
                    d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.41 2 2 0 0 1 3.6 1.22h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.96a16 16 0 0 0 6.13 6.13l.95-.95a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"
                  >
                  </path>
                </svg>
                <div>
                  <div class="info-label">Pendaftaran Online & Offline</div>
                  <div class="info-value">
                    Jl. Nurul Imam No. 12, atau via website
                  </div>
                </div>
              </div>
              <div class="info-item">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="#52b788"
                  stroke-width="1.8"
                  style="margin-top:1px;flex-shrink:0;"
                >
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle
                    cx="9"
                    cy="7"
                    r="4"
                  >
                  </circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75">
                  </path>
                </svg>
                <div>
                  <div class="info-label">Jenjang yang Tersedia</div>
                  <div class="info-value">SD Islam · SMP Islam · SMA Islam</div>
                </div>
              </div>
              <div class="info-item">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="#52b788"
                  stroke-width="1.8"
                  style="margin-top:1px;flex-shrink:0;"
                >
                  <rect
                    x="3"
                    y="4"
                    width="18"
                    height="18"
                    rx="2"
                  >
                  </rect>
                  <line
                    x1="16"
                    y1="2"
                    x2="16"
                    y2="6"
                  >
                  </line>
                  <line
                    x1="8"
                    y1="2"
                    x2="8"
                    y2="6"
                  >
                  </line>
                  <line
                    x1="3"
                    y1="10"
                    x2="21"
                    y2="10"
                  >
                  </line>
                </svg>
                <div>
                  <div class="info-label">Periode Pendaftaran</div>
                  <div
                    class="info-value"
                    id="ppdb-periode"
                  >
                    1 Juni – 31 Juli 2025
                  </div>
                </div>
              </div>
            </div>

            <!-- CTA buttons -->
            <div class="ppdb-cta-row">
              <a
                href="/ppdb-daftar"
                class="cta-btn"
              >
                Daftar Sekarang
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <path d="M5 12h14M12 5l7 7-7 7"></path>
                </svg>
              </a>
              <a
                href="/ppdb/info"
                class="sec-btn"
              >
                Info Lengkap
              </a>
            </div>
          </div>

          <!-- Kanan: countdown + progress -->
          <div class="ppdb-right">
            <!-- Countdown header -->
            <div class="ornament-line">
              <span
                class="ornament-text"
                id="ppdb-countdown-label"
              >
                Pendaftaran dibuka dalam
              </span>
            </div>

            <!-- Countdown grid -->
            <div
              class="ppdb-countdown"
              id="ppdb-countdown"
            >
              <div class="countdown-box">
                <span
                  class="countdown-num"
                  id="cd-hari"
                >
                  00
                </span>
                <span class="countdown-label">Hari</span>
              </div>
              <div class="countdown-box">
                <span
                  class="countdown-num"
                  id="cd-jam"
                >
                  00
                </span>
                <span class="countdown-label">Jam</span>
              </div>
              <div class="countdown-box">
                <span
                  class="countdown-num"
                  id="cd-menit"
                >
                  00
                </span>
                <span class="countdown-label">Menit</span>
              </div>
              <div class="countdown-box">
                <span
                  class="countdown-num"
                  id="cd-detik"
                >
                  00
                </span>
                <span class="countdown-label">Detik</span>
              </div>
            </div>

            <!-- Progress bar kuota -->
            <div class="kuota-card">
              <div class="kuota-header">
                <span class="kuota-title">Kuota terisi</span>
                <span
                  class="kuota-pct"
                  id="ppdb-kuota-pct"
                >
                  68%
                </span>
              </div>
              <div class="kuota-track">
                <div
                  id="ppdb-progress-fill"
                  style="width:0%"
                >
                </div>
              </div>
              <div class="kuota-footer">
                <span>204 pendaftar</span>
                <span>Kuota 300 siswa</span>
              </div>
            </div>

            <!-- Mini checklist syarat -->
            <div
              class="ornament-line"
              style="margin-top:24px;"
            >
              <span class="ornament-text">Syarat dokumen</span>
            </div>
            <div class="syarat-grid">
              {
                [
                  "Akta Kelahiran",
                  "KK / KTP Orang Tua",
                  "Ijazah Terakhir",
                  "Pas Foto 3×4",
                  "Surat Keterangan Sehat",
                  "Raport Semester",
                ].map((item) => (
                  <div class="syarat-item">
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="#52b788"
                      stroke-width="2.5"
                      style="flex-shrink:0;"
                    >
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                    {item}
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>

    <script define:vars={{ PPDB_OPEN, PPDB_CLOSE }}>
      const openDate = new Date(PPDB_OPEN);
      const closeDate = new Date(PPDB_CLOSE);

      const badge = document.getElementById("ppdb-status-badge");
      const pulse = document.getElementById("ppdb-pulse");
      const statusTxt = document.getElementById("ppdb-status-text");
      const cdLabel = document.getElementById("ppdb-countdown-label");
      const progressFill = document.getElementById("ppdb-progress-fill");

      setTimeout(() => {
        if (progressFill) progressFill.style.width = "68%";
      }, 300);

      function pad(n) {
        return String(n).padStart(2, "0");
      }

      function tick() {
        const now = new Date();
        let target;

        if (now < openDate) {
          badge.className = "status-badge badge-soon";
          pulse.style.background = "var(--gold)";
          statusTxt.textContent = "Segera Dibuka";
          cdLabel.textContent = "Pendaftaran dibuka dalam";
          target = openDate;
        } else if (now >= openDate && now <= closeDate) {
          badge.className = "status-badge badge-open";
          pulse.style.background = "#52b788";
          statusTxt.textContent = "Pendaftaran Dibuka";
          cdLabel.textContent = "Pendaftaran ditutup dalam";
          target = closeDate;
        } else {
          badge.className = "status-badge badge-closed";
          pulse.style.animation = "none";
          pulse.style.background = "#e05050";
          statusTxt.textContent = "Pendaftaran Ditutup";
          cdLabel.textContent = "Pendaftaran telah berakhir";
          ["cd-hari", "cd-jam", "cd-menit", "cd-detik"].forEach(
            (id) => (document.getElementById(id).textContent = "00"),
          );
          return;
        }

        const diff = Math.max(0, target - now);
        document.getElementById("cd-hari").textContent = pad(
          Math.floor(diff / 86400000),
        );
        document.getElementById("cd-jam").textContent = pad(
          Math.floor((diff % 86400000) / 3600000),
        );
        document.getElementById("cd-menit").textContent = pad(
          Math.floor((diff % 3600000) / 60000),
        );
        document.getElementById("cd-detik").textContent = pad(
          Math.floor((diff % 60000) / 1000),
        );
      }

      tick();
      setInterval(tick, 1000);
    </script>
  </section>
</BaseLayout>
