---
import {
  identitas,
  stats,
  statistik,
  prosesPembelajaran,
  milestones,
  pimpinan,
  gallery,
  categories,
} from "../../../data/sdit1";
---

<!-- ╔══════════════════════════════════════╗ --><!-- ║        7. STATISTIK SEKOLAH          ║ --><!-- ╚══════════════════════════════════════╝ -->
<section class="py-20 bg-white">
  <div class="max-w-5xl mx-auto px-6">
    <div class="text-center mb-12">
      <span
        class="inline-block bg-green-100 text-green-600 px-4 py-2 rounded-full text-sm font-semibold mb-4"
      >
        Statistik
      </span>
      <h2 class="text-4xl md:text-5xl font-bold text-gray-800">
        Statistik <span class="text-green-600">Sekolah</span>
      </h2>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 mb-12">
      {
        statistik.map((item) => (
          <div class="bg-slate-50 border border-slate-200 rounded-2xl p-5 text-center hover:border-emerald-300 hover:bg-emerald-50 transition">
            <div class="w-10 h-10 bg-emerald-100 text-emerald-700 rounded-xl flex items-center justify-center mx-auto mb-3 text-lg">
              <i class={`fas ${item.icon}`} />
            </div>
            <div class="font-serif text-3xl font-bold text-emerald-700 leading-none mb-1">
              {item.value}
            </div>
            <div class="text-xs text-slate-500 font-medium">{item.label}</div>
          </div>
        ))
      }
    </div>

    <div
      class="bg-slate-50 border border-slate-200 rounded-3xl overflow-hidden"
    >
      <div class="bg-emerald-700 px-8 py-4">
        <h3 class="text-white font-bold text-lg flex items-center gap-2">
          <i class="fas fa-chart-bar"></i> Proses Pembelajaran
        </h3>
      </div>
      <div class="divide-y divide-slate-100">
        {
          prosesPembelajaran.map((row) => (
            <div class="grid grid-cols-2 px-8 py-3.5 hover:bg-emerald-50 transition">
              <span class="text-sm text-slate-500 font-medium">
                {row.label}
              </span>
              <span class="text-sm text-slate-800 font-bold">{row.value}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
