---
import {
  identitas,
  stats,
  statistik,
  prosesPembelajaran,
  milestones,
  pimpinan,
  gallery,
  categories,
} from "../../../data/sdit1";
---

<!-- ╔══════════════════════════════════════╗ --><!-- ║        6. GALLERY + FILTER           ║ --><!-- ╚══════════════════════════════════════╝ -->
<section class="py-20 bg-slate-50">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-10">
      <span
        class="inline-block bg-green-100 text-green-600 px-4 py-2 rounded-full text-sm font-semibold mb-4"
      >
        Gallery
      </span>
      <h2 class="text-4xl md:text-5xl font-bold text-gray-800">
        Dokumentasi <span class="text-green-600">Kegiatan Sekolah</span>
      </h2>
    </div>

    <div
      class="flex flex-wrap justify-center gap-2 mb-10"
      id="gallery-filters"
    >
      {
        categories.map((cat) => (
          <button
            data-filter={cat === "Semua" ? "all" : cat}
            class={`px-4 py-2 rounded-full text-sm font-semibold border transition-all duration-200
              ${
                cat === "Semua"
                  ? "bg-emerald-600 text-white border-emerald-600"
                  : "bg-white text-slate-600 border-slate-200 hover:border-emerald-400 hover:text-emerald-600"
              }`}
          >
            {cat}
          </button>
        ))
      }
    </div>

    <div
      class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8"
      id="gallery-grid"
    >
      {
        gallery.map((item) => (
          <div
            class="group bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-xl transition duration-300"
            data-category={item.category}
          >
            <div class="overflow-hidden bg-slate-100">
              <img
                src={item.image}
                alt={item.title}
                loading="lazy"
                class="w-full h-64 object-cover group-hover:scale-110 transition duration-500"
              />
            </div>
            <div class="p-6">
              <span class="inline-block text-xs font-bold uppercase tracking-wider text-emerald-600 bg-emerald-50 px-3 py-1 rounded-full mb-3">
                {item.category}
              </span>
              <h3 class="text-xl font-bold text-slate-900">{item.title}</h3>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
