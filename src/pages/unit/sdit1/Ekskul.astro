---
import {
  identitas,
  stats,
  statistik,
  prosesPembelajaran,
  milestones,
  pimpinan,
  gallery,
  categories,
} from "../../../data/sdit1";
---

<!-- ╔══════════════════════════════════════╗ --><!-- ║        5. EKSTRAKURIKULER            ║ --><!-- ╚══════════════════════════════════════╝ -->
<section class="py-20 bg-white">
  <div class="max-w-5xl mx-auto px-6">
    <div class="text-center mb-12">
      <span
        class="inline-block bg-green-100 text-green-600 px-4 py-2 rounded-full text-sm font-semibold mb-4"
      >
        Ekstrakurikuler
      </span>
      <h2 class="text-4xl md:text-5xl font-bold text-gray-800">
        Kegiatan <span class="text-green-600">Ekstrakurikuler</span>
      </h2>
      <p class="text-slate-500 mt-4 max-w-xl mx-auto text-sm leading-relaxed">
        Pengembangan bakat dan minat siswa melalui berbagai kegiatan ekstra yang
        beragam dan berkualitas
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        [
          {
            icon: "fa-drum",
            category: "Seni & Budaya",
            name: "Hadroh",
            desc: "Kesenian musik Islami yang memupuk kecintaan terhadap budaya Islam melalui lantunan shalawat dan rebana.",
          },
          {
            icon: "fa-music",
            category: "Seni & Budaya",
            name: "Angklung",
            desc: "Alat musik tradisional Sunda yang melatih kerja sama, koordinasi, dan kecintaan terhadap budaya Nusantara.",
          },
          {
            icon: "fa-comments",
            category: "Akademik",
            name: "Bahasa Inggris",
            desc: "Pengembangan kemampuan komunikasi bahasa Inggris secara aktif melalui percakapan dan praktik langsung.",
          },
          {
            icon: "fa-quran",
            category: "Keislaman",
            name: "Tahta",
            desc: "Kegiatan Tahsin dan Tahfidz Al-Qur'an intensif untuk memperkuat bacaan dan hafalan Al-Qur'an siswa.",
          },
          {
            icon: "fa-fist-raised",
            category: "Bela Diri",
            name: "Silat Merpati Putih",
            desc: "Pencak silat tradisional Indonesia yang melatih kedisiplinan, ketangkasan, dan karakter siswa.",
          },
          {
            icon: "fa-person-falling",
            category: "Bela Diri",
            name: "Taekwondo",
            desc: "Olahraga bela diri asal Korea yang melatih fisik, mental, serta semangat sportivitas siswa.",
          },
          {
            icon: "fa-futbol",
            category: "Olahraga",
            name: "Futsal",
            desc: "Olahraga tim yang membangun jiwa kerja sama, kepemimpinan, dan kebugaran jasmani siswa.",
          },
          {
            icon: "fa-code",
            category: "Teknologi",
            name: "Coding (Scratch)",
            desc: "Pengenalan pemrograman berbasis visual menggunakan Scratch untuk melatih logika dan kreativitas digital.",
          },
          {
            icon: "fa-robot",
            category: "Teknologi",
            name: "Robotic",
            desc: "Kegiatan merakit dan memprogram robot sederhana yang melatih kemampuan STEM secara menyenangkan.",
          },
          {
            icon: "fa-campground",
            category: "Kepramukaan",
            name: "Pramuka",
            desc: "Kegiatan kepramukaan wajib yang membentuk karakter, kemandirian, dan jiwa sosial siswa.",
          },
          {
            icon: "fa-bullseye",
            category: "Olahraga",
            name: "Panahan",
            desc: "Olahraga panahan yang melatih fokus, ketenangan, dan kedisiplinan siswa sesuai sunnah Rasulullah SAW.",
          },
        ].map((item) => (
          <div class="bg-white border border-slate-200 rounded-3xl p-6 hover:border-emerald-300 hover:shadow-lg transition duration-300 flex flex-col gap-4">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 flex-shrink-0 bg-emerald-600 text-white rounded-2xl flex items-center justify-center text-xl">
                <i class={`fas ${item.icon}`} />
              </div>
              <div>
                <span class="inline-block text-xs font-bold uppercase tracking-wider text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full mb-1">
                  {item.category}
                </span>
                <h3 class="text-lg font-bold text-slate-800">{item.name}</h3>
              </div>
            </div>
            <p class="text-sm text-slate-600 leading-relaxed">{item.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
