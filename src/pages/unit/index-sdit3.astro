---
// src/pages/unit/sdit3.astro

import BaseLayout from "../../layouts/BaseLayout.astro";

import {
  identitas,
  stats,
  statistik,
  prosesPembelajaran,
  pimpinan,
  gallery,
  categories,
} from "../../data/sdit3";

// section components
import Hero from "./sdit3/Hero.astro";
import Stats from "./sdit3/Stats.astro";
import Tentang from "./sdit3/Tentang.astro";
import Pimpinan from "./sdit3/Pimpinan.astro";
import Keunggulan from "./sdit3/Keunggulan.astro";
import Visimisi from "./sdit3/Visimisi.astro";
import Kompetensi from "./sdit3/Kompetensi.astro";
import Ekskul from "./sdit3/Ekskul.astro";
import Gallery from "./sdit3/Gallery.astro";
import Statistik from "./sdit3/Statistik.astro";
import Identitas from "./sdit3/Identitas.astro";
import CTA from "./sdit3/CTA.astro";
---

<BaseLayout
  title="Profil SDIT Nurul Imam Karawang 1"
  description="Profil lengkap SDIT Nurul Imam 3 Karawang, sekolah dasar Islam terpadu dengan akreditasi A, kurikulum merdeka dan pembelajaran full day school."
  theme="green"
>
  <Hero />

  <Stats stats={stats} />

  <Tentang />

  <Pimpinan pimpinan={pimpinan} />

  <Keunggulan />

  <Visimisi />

  <Kompetensi />

  <Ekskul />

  <Gallery
    gallery={gallery}
    categories={categories}
  />

  <Statistik
    statistik={statistik}
    proses={prosesPembelajaran}
  />

  <Identitas identitas={identitas} />

  <CTA />
</BaseLayout>
