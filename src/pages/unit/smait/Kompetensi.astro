---
import { kompetensi } from "../../../data/smait";
---

<!-- ╔══════════════════════════════════════╗ --><!-- ║         KOMPETENSI LULUSAN          ║ --><!-- ╚══════════════════════════════════════╝ -->
<section class="py-20 bg-white">
  <div class="max-w-5xl mx-auto px-6">
    <div class="text-center mb-12">
      <span
        class="inline-block bg-violet-100 text-violet-600 px-4 py-2 rounded-full text-sm font-semibold mb-4"
      >
        Kompetensi
      </span>
      <h2 class="text-4xl md:text-5xl font-bold text-gray-800">
        Kompetensi <span class="text-violet-500">Lulusan</span>
      </h2>
      <p class="text-slate-500 mt-4 max-w-xl mx-auto text-sm leading-relaxed">
        Standar kompetensi lulusan SMAIT Bilingual Nurul Imam selama 3 (tiga)
        tahun pendidikan
      </p>
    </div>

    <div class="grid sm:grid-cols-2 gap-4">
      {
        kompetensi.map((item, i) => (
          <div class="flex items-start gap-4 bg-violet-50 border border-violet-100 rounded-2xl px-6 py-5 hover:border-violet-300 hover:shadow-sm transition">
            <div class="w-10 h-10 flex-shrink-0 bg-violet-500 text-white rounded-xl flex items-center justify-center text-base">
              <i class={`fas ${item.icon}`} />
            </div>
            <div class="flex items-start gap-3">
              <span class="w-5 h-5 rounded-full bg-violet-200 text-violet-800 text-xs font-bold flex items-center justify-center flex-shrink-0 mt-0.5">
                {i + 1}
              </span>
              <p class="text-sm text-slate-700 leading-relaxed font-medium">
                {item.text}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
