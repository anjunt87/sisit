---
// src/pages/unit/smpit.astro

import BaseLayout from "../../layouts/BaseLayout.astro";

import {
  identitas,
  stats,
  statistik,
  prosesPembelajaran,
  pimpinan,
  gallery,
  categories,
} from "../../data/smpit";

// section components
import Hero from "./smpit/Hero.astro";
import Stats from "./smpit/Stats.astro";
import Tentang from "./smpit/Tentang.astro";
import Visimisi from "./smpit/Visimisi.astro";
import Pimpinan from "./smpit/Pimpinan.astro";
import Keunggulan from "./smpit/Keunggulan.astro";
import Ekskul from "./smpit/Ekskul.astro";
import Gallery from "./smpit/Gallery.astro";
import Statistik from "./smpit/Statistik.astro";
import Identitas from "./smpit/Identitas.astro";
import CTA from "./smpit/CTA.astro";
---

<BaseLayout
  title="Profil SDIT Nurul Imam Karawang 1"
  description="Profil lengkap SDIT Nurul Imam Karawang, sekolah dasar Islam terpadu dengan akreditasi A, kurikulum merdeka dan pembelajaran full day school."
>
  <Hero />

  <Stats stats={stats} />

  <Tentang />

  <Pimpinan pimpinan={pimpinan} />

  <Visimisi />

  <Keunggulan />

  <Ekskul />

  <Gallery
    gallery={gallery}
    categories={categories}
  />

  <Statistik
    statistik={statistik}
    proses={prosesPembelajaran}
  />

  <Identitas identitas={identitas} />

  <CTA />
</BaseLayout>
