<style>
  /*
   * =============================================================
   * ANIMASI: Cascade fade-up per level
   * Trigger: Intersection Observer (saat section masuk viewport)
   * =============================================================
   */

  /* State awal — semua elemen tidak terlihat, geser ke bawah 24px */
  .org-animate {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
    /* tidak ada transition-delay — timing diatur oleh scroll */
  }

  .org-connector {
    height: 0;
    transition: height 0.35s ease;
  }

  /* State aktif per elemen — bukan per section */
  .org-animate.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .org-connector.is-visible {
    height: 24px;
  }

  @media (prefers-reduced-motion: reduce) {
    .org-animate {
      transition: opacity 0.3s ease;
      transform: none;
    }
    .org-connector {
      transition: none;
      height: 24px;
    }
  }
</style>

<script is:inline>
  /* ============================================================
   * Intersection Observer — trigger animasi saat section masuk
   * viewport minimal 15% (threshold: 0.15)
   * ============================================================ */
  (function () {
    const animItems = document.querySelectorAll(
      "#struktur .org-animate, #struktur .org-connector",
    );
    if (!animItems.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
          } else {
            // Hapus class saat elemen keluar viewport (scroll ke atas)
            entry.target.classList.remove("is-visible");
          }
        });
        // Tidak ada observer.unobserve() — terus pantau semua elemen
      },
      {
        threshold: 0.2,
        rootMargin: "0px 0px -30px 0px",
      },
    );

    animItems.forEach((el) => observer.observe(el));
  })();

  /* ============================================================
   * Toggle daftar staf lengkap
   * ============================================================ */
  window.toggleStaf = function (btn) {
    const daftar = document.getElementById("daftar-staf");
    const chevron = document.getElementById("chevron-staf");
    const isHidden = daftar.classList.contains("hidden");

    daftar.classList.toggle("hidden");
    chevron.style.transform = isHidden ? "rotate(180deg)" : "rotate(0deg)";

    btn.innerHTML = `
      <i class="fas fa-chevron-down text-[10px] transition-transform duration-300"
         id="chevron-staf"
         style="transform:${isHidden ? "rotate(180deg)" : "rotate(0deg)"}">
      </i>
      ${isHidden ? "Sembunyikan" : "Selengkapnya"}
    `;
  };
</script>
