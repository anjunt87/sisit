---
// src/pages/berita/index.astro
import Layout from "../../layouts/BaseLayout.astro";
import { newsList } from "../../data/news";

const categories = ["Semua", "Kegiatan", "Prestasi", "Pengumuman"];
const featured = newsList[0];
const rest = newsList.slice(1);
---

<Layout title="Berita & Kegiatan — Nurul Imam Islamic School">
  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
    slot="head"
  />
  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
    slot="head"
  />
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400&family=DM+Sans:wght@400;500;600&display=swap"
    rel="stylesheet"
    slot="head"
  />

  <section class="news-page">
    <div class="news-wrap">
      <!-- Masthead -->
      <div class="masthead">
        <div>
          <div class="masthead-label">Nurul Imam Islamic School</div>
          <h1 class="masthead-title">Berita &amp; Kegiatan</h1>
        </div>
        <div class="masthead-sub">
          Informasi seputar kegiatan, prestasi, dan perkembangan sekolah kami
          <div class="masthead-date">
            {
              new Date().toLocaleDateString("id-ID", {
                month: "long",
                year: "numeric",
              })
            }
          </div>
        </div>
      </div>

      <!-- Filter -->
      <div class="filter-row">
        {
          categories.map((cat) => (
            <button
              class={`filter-btn${cat === "Semua" ? " active" : ""}`}
              data-filter={cat.toLowerCase()}
            >
              {cat}
            </button>
          ))
        }
      </div>

      <!-- Featured -->
      {
        featured && (
          <div
            class="featured news-card"
            data-category={featured.category.toLowerCase()}
          >
            <a
              href={`/berita/${featured.id}`}
              class="featured-img-wrap"
            >
              <img
                src={featured.image}
                alt={featured.title}
                loading="eager"
                class="featured-img"
              />
            </a>
            <div class="featured-body">
              <div>
                <div class="featured-kicker">Utama · {featured.category}</div>
                <h2 class="featured-title">
                  <a href={`/berita/${featured.id}`}>{featured.title}</a>
                </h2>
                <p class="featured-desc">{featured.description}</p>
              </div>
              <div class="featured-bottom">
                <span class="featured-meta">
                  {featured.date} · {featured.readTime} menit baca
                </span>
                <a
                  href={`/berita/${featured.id}`}
                  class="card-link"
                >
                  Baca selengkapnya
                  <svg
                    viewBox="0 0 12 12"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    aria-hidden="true"
                  >
                    <path d="M2 10L10 2M10 2H4M10 2v6" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        )
      }

      <!-- Grid -->
      <div
        class="card-grid"
        id="cardGrid"
      >
        {
          rest.map((item) => (
            <article
              class="card news-card"
              data-category={item.category.toLowerCase()}
            >
              <a
                href={`/berita/${item.id}`}
                class="card-img-wrap"
              >
                <img
                  src={item.image}
                  alt={item.title}
                  loading="lazy"
                  class="card-img"
                />
              </a>
              <span class="card-cat">{item.category}</span>
              <h2 class="card-title">
                <a href={`/berita/${item.id}`}>{item.title}</a>
              </h2>
              <p class="card-desc">{item.description}</p>
              <div class="card-meta">
                <span>{item.date}</span>
                <span>{item.readTime} mnt baca</span>
              </div>
              <a
                href={`/berita/${item.id}`}
                class="card-link"
              >
                Baca selengkapnya
                <svg
                  viewBox="0 0 12 12"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  aria-hidden="true"
                >
                  <path d="M2 10L10 2M10 2H4M10 2v6" />
                </svg>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400&family=DM+Sans:wght@400;500;600&display=swap");

  :root {
    --ink: #1a1a18;
    --ink2: #4a4a46;
    --ink3: #8a8a84;
    --paper: #faf9f6;
    --paper2: #f0ede6;
    --green: #2d6a3f;
    --green-l: #e8f2eb;
    --green-m: #b8d9c2;
    --accent: #c8873a;
    --rule: 1px solid #d8d4cc;
  }

  .news-page {
    background: var(--paper);
    min-height: 100vh;
    padding: 3rem 1.5rem 5rem;
    font-family: "DM Sans", sans-serif;
  }

  .news-wrap {
    max-width: 960px;
    margin: 0 auto;
  }

  /* Masthead */
  .masthead {
    border-top: 3px solid var(--ink);
    border-bottom: var(--rule);
    padding: 1rem 0 0.875rem;
    margin-bottom: 1.75rem;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }
  .masthead-label {
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink3);
    font-weight: 600;
    margin-bottom: 4px;
  }
  .masthead-title {
    font-family: "Playfair Display", serif;
    font-size: 2.6rem;
    font-weight: 700;
    line-height: 1;
    color: var(--ink);
  }
  .masthead-sub {
    font-size: 13px;
    color: var(--ink2);
    max-width: 240px;
    text-align: right;
    line-height: 1.5;
  }
  .masthead-date {
    font-size: 11px;
    color: var(--ink3);
    letter-spacing: 0.08em;
    margin-top: 4px;
  }

  /* Filter */
  .filter-row {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
    padding-bottom: 1rem;
    border-bottom: var(--rule);
  }
  .filter-btn {
    font-family: "DM Sans", sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 6px 16px;
    border-radius: 2px;
    border: 1px solid var(--ink);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: all 0.15s;
  }
  .filter-btn:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .filter-btn.active {
    background: var(--green);
    color: #fff;
    border-color: var(--green);
  }

  /* Featured */
  .featured {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    border-top: 3px solid var(--ink);
    border-bottom: var(--rule);
    margin-bottom: 0;
  }
  .featured-img-wrap {
    display: block;
    overflow: hidden;
  }
  .featured-img {
    width: 100%;
    height: 280px;
    object-fit: cover;
    display: block;
    filter: grayscale(10%);
    transition: transform 0.4s ease;
  }
  .featured-img:hover {
    transform: scale(1.03);
  }
  .featured-body {
    padding: 1.5rem 1.375rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-left: var(--rule);
  }
  .featured-kicker {
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }
  .featured-title {
    font-family: "Playfair Display", serif;
    font-size: 1.55rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--ink);
    margin-bottom: 0.75rem;
  }
  .featured-title a {
    color: inherit;
    text-decoration: none;
  }
  .featured-title a:hover {
    color: var(--green);
  }
  .featured-desc {
    font-size: 13px;
    color: var(--ink2);
    line-height: 1.65;
  }
  .featured-bottom {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: var(--rule);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .featured-meta {
    font-size: 11px;
    color: var(--ink3);
  }

  /* Card Grid */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-bottom: var(--rule);
  }

  .card {
    border-top: var(--rule);
    padding: 1.25rem 1rem 1.5rem;
    transition: background 0.15s;
  }
  .card:hover {
    background: var(--paper2);
  }
  /* vertical dividers between columns */
  .card:nth-child(3n + 2) {
    border-left: var(--rule);
    border-right: var(--rule);
  }

  .card-img-wrap {
    display: block;
    overflow: hidden;
    margin-bottom: 0.875rem;
  }
  .card-img {
    width: 100%;
    height: 145px;
    object-fit: cover;
    display: block;
    filter: grayscale(15%);
    transition: transform 0.4s ease;
  }
  .card-img:hover {
    transform: scale(1.04);
  }
  .card-cat {
    display: block;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--green);
    margin-bottom: 0.5rem;
  }
  .card-title {
    font-family: "Playfair Display", serif;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--ink);
    margin-bottom: 0.5rem;
  }
  .card-title a {
    color: inherit;
    text-decoration: none;
  }
  .card-title a:hover {
    color: var(--green);
  }
  .card-desc {
    font-size: 12.5px;
    color: var(--ink2);
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }
  .card-meta {
    font-size: 11px;
    color: var(--ink3);
    display: flex;
    gap: 0;
    margin-bottom: 0.5rem;
  }
  .card-meta span + span::before {
    content: " · ";
  }

  /* Shared link style */
  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--green);
    text-decoration: none;
    border-bottom: 1px solid var(--green-m);
    padding-bottom: 1px;
    transition: border-color 0.15s;
  }
  .card-link:hover {
    border-color: var(--green);
  }
  .card-link svg {
    width: 10px;
    height: 10px;
  }

  /* Hidden state for filter */
  .news-card.hidden {
    display: none;
  }

  /* Responsive */
  @media (max-width: 680px) {
    .masthead {
      flex-direction: column;
      align-items: flex-start;
    }
    .masthead-sub {
      text-align: left;
    }
    .masthead-title {
      font-size: 2rem;
    }
    .featured {
      grid-template-columns: 1fr;
    }
    .featured-body {
      border-left: none;
      border-top: var(--rule);
    }
    .card-grid {
      grid-template-columns: 1fr;
    }
    .card:nth-child(3n + 2) {
      border-left: none;
      border-right: none;
    }
  }

  @media (min-width: 681px) and (max-width: 860px) {
    .card-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .card:nth-child(3n + 2) {
      border-left: none;
      border-right: none;
    }
    .card:nth-child(2n) {
      border-left: var(--rule);
    }
  }
</style>

<script>
  function initFilter() {
    const tabs = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const cards = document.querySelectorAll<HTMLElement>(".news-card");

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        tabs.forEach((t) => t.classList.remove("active"));
        tab.classList.add("active");

        const filter = tab.dataset.filter ?? "semua";
        cards.forEach((card) => {
          const cat = card.dataset.category ?? "";
          card.classList.toggle("hidden", filter !== "semua" && cat !== filter);
        });
      });
    });
  }

  initFilter();
  document.addEventListener("astro:after-swap", initFilter);
</script>
