---
// src/pages/berita/[id].astro
import Layout from "../../layouts/BaseLayout.astro";
import { newsList } from "../../data/news";

export function getStaticPaths() {
  return newsList.map((item) => ({
    params: { id: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const related = newsList.filter((n) => n.id !== item.id).slice(0, 3);
---

<Layout title={`${item.title} — Nurul Imam Islamic School`}>
  <style>
    @import url("https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=DM+Sans:wght@300;400;500&display=swap");

    :root {
      --ink: #0f1410;
      --ink-60: #0f141099;
      --green: #1a6b3a;
      --green-l: #d6ead f;
      --cream: #f7f5f0;
      --rule: #d4cfc6;
      --white: #ffffff;
    }

    .article-wrap {
      background: var(--cream);
      font-family: "DM Sans", sans-serif;
      color: var(--ink);
      min-height: 100vh;
    }

    /* ── HERO ── */
    .hero {
      position: relative;
      height: 90vh;
      min-height: 560px;
      overflow: hidden;
    }

    .hero__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transform: scale(1.04);
      animation: zoomOut 8s ease forwards;
    }

    @keyframes zoomOut {
      to {
        transform: scale(1);
      }
    }

    .hero__vignette {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(to top, #0f1410ee 0%, #0f141060 40%, transparent 70%),
        linear-gradient(to right, #0f141030 0%, transparent 60%);
    }

    .hero__back {
      position: absolute;
      top: 28px;
      left: 28px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: "DM Sans", sans-serif;
      font-size: 0.78rem;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.85);
      text-decoration: none;
      padding: 8px 18px;
      border: 1px solid rgba(255, 255, 255, 0.25);
      border-radius: 2px;
      backdrop-filter: blur(6px);
      background: rgba(255, 255, 255, 0.08);
      transition:
        background 0.2s,
        color 0.2s;
    }

    .hero__back:hover {
      background: rgba(255, 255, 255, 0.18);
      color: #fff;
    }

    .hero__content {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 0 6vw 56px;
      max-width: 860px;
    }

    .hero__cat {
      display: inline-block;
      font-size: 0.7rem;
      font-weight: 500;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: #fff;
      background: var(--green);
      padding: 5px 14px;
      border-radius: 2px;
      margin-bottom: 20px;
      animation: fadeUp 0.8s 0.2s both;
    }

    .hero__title {
      font-family: "Playfair Display", serif;
      font-size: clamp(2rem, 5vw, 3.8rem);
      font-weight: 900;
      color: #fff;
      line-height: 1.1;
      margin: 0 0 20px;
      animation: fadeUp 0.8s 0.35s both;
    }

    .hero__meta {
      display: flex;
      align-items: center;
      gap: 16px;
      font-size: 0.8rem;
      color: rgba(255, 255, 255, 0.6);
      letter-spacing: 0.04em;
      animation: fadeUp 0.8s 0.5s both;
    }

    .hero__meta-dot {
      width: 3px;
      height: 3px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.4);
    }

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(18px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* ── LAYOUT ── */
    .content-wrap {
      display: grid;
      grid-template-columns: 1fr 300px;
      gap: 64px;
      max-width: 1100px;
      margin: 0 auto;
      padding: 72px 32px 96px;
    }

    @media (max-width: 900px) {
      .content-wrap {
        grid-template-columns: 1fr;
        gap: 48px;
        padding: 48px 20px 72px;
      }
    }

    /* ── MAIN ARTICLE ── */
    .article-lead {
      font-size: 1.2rem;
      font-weight: 300;
      line-height: 1.75;
      color: var(--ink);
      padding: 28px 0 28px 24px;
      border-left: 3px solid var(--green);
      margin-bottom: 40px;
    }

    .article-rule {
      border: none;
      border-top: 1px solid var(--rule);
      margin: 40px 0;
    }

    .article-body {
      font-size: 1.05rem;
      line-height: 1.85;
      color: #2a2f2b;
      white-space: pre-line;
    }

    .article-body p {
      margin-bottom: 1.6em;
    }

    /* ── SHARE ── */
    .share-block {
      margin-top: 56px;
      padding-top: 32px;
      border-top: 1px solid var(--rule);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px;
    }

    .share-label {
      font-size: 0.72rem;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ink-60);
      margin-right: 4px;
    }

    .share-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 0.8rem;
      font-weight: 500;
      padding: 9px 20px;
      border-radius: 2px;
      border: 1px solid transparent;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.2s;
      font-family: "DM Sans", sans-serif;
    }

    .share-btn--wa {
      background: var(--green);
      color: #fff;
    }

    .share-btn--wa:hover {
      background: #145530;
    }

    .share-btn--copy {
      background: transparent;
      color: var(--ink);
      border-color: var(--rule);
    }

    .share-btn--copy:hover {
      border-color: var(--green);
      color: var(--green);
    }

    /* ── SIDEBAR ── */
    .sidebar {
      position: relative;
    }

    .sidebar-sticky {
      position: sticky;
      top: 100px;
      display: flex;
      flex-direction: column;
      gap: 40px;
    }

    .sidebar-section-label {
      font-size: 0.65rem;
      font-weight: 500;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--green);
      border-bottom: 1px solid var(--rule);
      padding-bottom: 10px;
      margin-bottom: 16px;
    }

    .sidebar-info p {
      font-size: 0.82rem;
      color: var(--ink-60);
      line-height: 1.6;
      display: flex;
      flex-direction: column;
      gap: 4px;
      margin-bottom: 14px;
    }

    .sidebar-info strong {
      color: var(--ink);
      font-weight: 500;
    }

    .sidebar-quote {
      background: var(--white);
      border-left: 3px solid var(--green);
      padding: 20px 20px 20px 24px;
    }

    .sidebar-quote blockquote {
      font-family: "Playfair Display", serif;
      font-style: italic;
      font-size: 1rem;
      line-height: 1.65;
      color: var(--ink);
      margin: 0 0 10px;
    }

    .sidebar-quote cite {
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--green);
      font-style: normal;
    }

    /* ── RELATED ── */
    .related-section {
      background: var(--ink);
      padding: 80px 32px;
    }

    .related-inner {
      max-width: 1100px;
      margin: 0 auto;
    }

    .related-header {
      display: flex;
      align-items: baseline;
      gap: 20px;
      margin-bottom: 48px;
    }

    .related-label {
      font-size: 0.68rem;
      font-weight: 500;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--green);
    }

    .related-title {
      font-family: "Playfair Display", serif;
      font-size: 1.8rem;
      font-weight: 700;
      color: #fff;
    }

    .related-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2px;
    }

    @media (max-width: 768px) {
      .related-grid {
        grid-template-columns: 1fr;
      }
    }

    .related-card {
      position: relative;
      display: block;
      text-decoration: none;
      overflow: hidden;
      aspect-ratio: 4/3;
    }

    .related-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition:
        transform 0.5s ease,
        filter 0.4s;
      filter: brightness(0.55) saturate(0.8);
    }

    .related-card:hover img {
      transform: scale(1.06);
      filter: brightness(0.4) saturate(0.7);
    }

    .related-card-body {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 24px 20px 20px;
      background: linear-gradient(
        to top,
        rgba(0, 0, 0, 0.85) 0%,
        transparent 100%
      );
      transform: translateY(6px);
      transition: transform 0.3s;
    }

    .related-card:hover .related-card-body {
      transform: translateY(0);
    }

    .related-card-cat {
      font-size: 0.62rem;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--green);
      display: block;
      margin-bottom: 6px;
    }

    /* green accent in dark context needs lighter shade */
    .related-card-cat {
      color: #5ecb8a;
    }

    .related-card-title {
      font-family: "Playfair Display", serif;
      font-size: 1rem;
      font-weight: 700;
      color: #fff;
      line-height: 1.35;
      margin-bottom: 6px;
    }

    .related-card-date {
      font-size: 0.72rem;
      color: rgba(255, 255, 255, 0.45);
    }
  </style>

  <article class="article-wrap">
    <!-- ── HERO ── -->
    <div class="hero">
      <img
        src={item.image}
        alt={item.title}
        class="hero__img"
      />
      <div class="hero__vignette"></div>
      <!-- 
      <a
        href="/berita"
        class="hero__back"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M13 8H3M7 4l-4 4 4 4"></path>
        </svg>
        Semua Berita
      </a> -->

      <div class="hero__content">
        <span class="hero__cat">{item.category}</span>
        <h1 class="hero__title">{item.title}</h1>
        <div class="hero__meta">
          <span>{item.date}</span>
          <span class="hero__meta-dot"></span>
          <span>{item.readTime} menit baca</span>
          <span class="hero__meta-dot"></span>
          <span>Nurul Imam Islamic School</span>
        </div>
      </div>
    </div>

    <!-- ── CONTENT ── -->
    <div class="content-wrap">
      <!-- Main -->
      <main>
        <p class="article-lead">{item.description}</p>
        <hr class="article-rule" />
        <div class="article-body">{item.content}</div>

        <!-- Share -->
        <div class="share-block">
          <span class="share-label">Bagikan</span>
          <a
            href={`https://wa.me/?text=${encodeURIComponent(item.title + " — " + Astro.url.href)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="share-btn share-btn--wa"
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"
              >
              </path>
            </svg>
            WhatsApp
          </a>
          <button
            id="copyLink"
            class="share-btn share-btn--copy"
          >
            <svg
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <rect
                x="9"
                y="9"
                width="13"
                height="13"
                rx="2"
              >
              </rect>
              <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1">
              </path>
            </svg>
            Salin Tautan
          </button>
        </div>
      </main>

      <!-- Sidebar -->
      <aside class="sidebar">
        <div class="sidebar-sticky">
          <!-- Info -->
          <div class="sidebar-info">
            <p class="sidebar-section-label">Detail Berita</p>
            <p>
              <strong>Tanggal</strong>
              {item.date}
            </p>
            <p>
              <strong>Kategori</strong>
              {item.category}
            </p>
            <p>
              <strong>Estimasi Baca</strong>
              {item.readTime} menit
            </p>
            <p>
              <strong>Sumber</strong>
              Nurul Imam Islamic School
            </p>
          </div>

          <!-- Pull quote -->
          <div class="sidebar-quote">
            <p class="sidebar-section-label">Sorotan</p>
            <blockquote>"{item.description}"</blockquote>
            <cite>— Tim Redaksi</cite>
          </div>
        </div>
      </aside>
    </div>

    <!-- ── RELATED ── -->
    {
      related.length > 0 && (
        <section class="related-section">
          <div class="related-inner">
            <div class="related-header">
              <span class="related-label">Baca Juga</span>
              <h2 class="related-title">Berita Lainnya</h2>
            </div>
            <div class="related-grid">
              {related.map((rel) => (
                <a
                  href={`/berita/${rel.id}`}
                  class="related-card"
                >
                  <img
                    src={rel.image}
                    alt={rel.title}
                    loading="lazy"
                  />
                  <div class="related-card-body">
                    <span class="related-card-cat">{rel.category}</span>
                    <p class="related-card-title">{rel.title}</p>
                    <span class="related-card-date">{rel.date}</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }
  </article>

  <script>
    const btn = document.getElementById("copyLink");
    btn?.addEventListener("click", () => {
      navigator.clipboard.writeText(window.location.href).then(() => {
        if (btn) btn.textContent = "✓ Disalin!";
        setTimeout(() => {
          if (btn) btn.textContent = "Salin Tautan";
        }, 2000);
      });
    });
  </script>
</Layout>
