---
//src\layouts\BaseLayout.astro
import "../styles/global.css";
import "@fortawesome/fontawesome-free/css/all.min.css";
import Analytics from "@vercel/analytics/astro";
export { initMobileMenu } from "../scripts/mobileMenu";
export { initSmoothScroll } from "../scripts/smoothScroll";
export { initBackToTop } from "../scripts/backToTop";
// export { initChatBot } from "../scripts/chatBot";
export { initLazyImage } from "../scripts/lazyImage";
export { initContactForm } from "../scripts/contactForm";

import Navbar from "../components/landing/Navbar.astro";
import Footer from "../components/landing/Footer.astro";
import FloatingButtons from "../components/ui/FloatingButtons.astro";
import Chatbot from "../components/ui/Chatbot.astro";

import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  theme?: string;
}

const {
  title = "Nurul Imam Islamic School",
  description = "Sekolah Islam terbaik di Karawang",
  theme = "green",
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>{title}</title>
    <meta
      name="description"
      content={description}
    />
    <meta
      name="theme-color"
      content="#059669"
    />

    <link
      rel="icon"
      href="/favicon.png"
    />
  </head>
  <Analytics />
  <body
    class={`theme-${theme} bg-white text-gray-900 antialiased overflow-x-hidden`}
  >
    <!-- Navbar -->
    <!-- <Navbar transparent={true} /> -->
    <Navbar transparent={false} />

    <main>
      <slot />
    </main>

    <!-- UI floating -->
    <FloatingButtons />
    <Chatbot />

    <Footer />
  </body>
  <script>
    import {
      initMobileMenu,
      initSmoothScroll,
      initBackToTop,
      initLazyImage,
      initContactForm,
      initScrollAnimation,
      // initChatBot,
    } from "../scripts/main";

    initMobileMenu();
    initSmoothScroll("mobileMenu");
    initBackToTop();
    initLazyImage();
    initContactForm();
    // initChatBot();
    initScrollAnimation();
  </script>

</html>
