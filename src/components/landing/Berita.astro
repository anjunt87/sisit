---
// src/components/landing/Berita.astro
import { beritaList } from "../../data/berita";
---

<section
  id="berita"
  class="py-20 bg-green-50 px-6"
>
  <div class="max-w-7xl mx-auto">
    <!-- Heading -->
    <div
      class="text-center mb-16"
      data-aos="fade-down"
    >
      <span
        class="inline-block bg-green-100 text-green-700 px-4 py-2 rounded-full text-sm font-semibold mb-4"
      >
        Berita
      </span>

      <h2 class="text-4xl md:text-5xl font-bold mb-6 text-gray-800">
        Kabar <span class="text-green-600">Terbaru</span>
      </h2>

      <p class="text-gray-600 max-w-2xl mx-auto">
        Informasi seputar kegiatan, prestasi, dan perkembangan di Nurul Imam
        Islamic School.
      </p>
    </div>

    <!-- Swiper -->
    <div
      class="swiper berita-swiper"
      data-aos="fade-up"
    >
      <div class="swiper-wrapper pb-10">
        {
          beritaList.map((item, index) => (
            <div class="swiper-slide">
              <div
                class="bg-white rounded-2xl shadow-md hover:shadow-lg transition duration-300 flex flex-col h-full overflow-hidden"
                data-aos="zoom-in-up"
                data-aos-delay={(index + 1) * 100}
              >
                <div class="h-48">
                  <img
                    src={item.image}
                    alt={item.title}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                </div>

                <div class="p-6 flex flex-col flex-grow">
                  <h3 class="text-xl font-bold text-green-700 mb-2">
                    {item.title}
                  </h3>

                  <p class="text-gray-600 text-sm line-clamp-2 flex-grow">
                    {item.description}
                  </p>

                  <a
                    href={item.link}
                    class="text-green-600 text-sm font-semibold hover:underline mt-4"
                  >
                    Lihat Detail
                  </a>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Pagination -->
      <div class="swiper-pagination mt-8"></div>
    </div>
  </div>
</section>

<style>
  .berita-swiper .swiper-pagination-bullet {
    background: #10b981;
    opacity: 0.5;
  }

  .berita-swiper .swiper-pagination-bullet-active {
    opacity: 1;
    background: #059669;
  }

  .berita-swiper .swiper-button-next,
  .berita-swiper .swiper-button-prev {
    color: #059669;
  }

  .berita-swiper .swiper-button-next:hover,
  .berita-swiper .swiper-button-prev:hover {
    color: #10b981;
  }

  .swiper-slide {
    transition: transform 0.3s ease;
  }

  .swiper-slide:hover {
    transform: translateY(-5px);
  }
</style>
<script>
  import Swiper from "swiper";
  import { Autoplay, Pagination } from "swiper/modules";
  import "swiper/css";
  import "swiper/css/pagination";

  let swiper = null;

  function init() {
    if (swiper) {
      swiper.destroy(true, true);
      swiper = null;
    }
    const el = document.querySelector(".berita-swiper");
    if (!el) return;
    swiper = new Swiper(".berita-swiper", {
      modules: [Autoplay, Pagination],
      slidesPerView: 1,
      spaceBetween: 20,
      loop: true,
      autoplay: { delay: 4000, disableOnInteraction: false },
      pagination: { el: ".berita-swiper .swiper-pagination", clickable: true },
      breakpoints: {
        768: { slidesPerView: 2 },
        1024: { slidesPerView: 3 },
      },
    });
  }

  init();
  document.addEventListener("astro:after-swap", init);
  document.addEventListener("astro:before-swap", () => {
    if (swiper) {
      swiper.destroy(true, true);
      swiper = null;
    }
  });
</script>
