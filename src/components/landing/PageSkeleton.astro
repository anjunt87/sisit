        >
        </div>
        <div
          class="sk sk-ft2"
          style="width:80%;"
        >
        </div>
        <div
          class="sk sk-ft2"
          style="width:70%;"
        >
        </div>
        <div style="display:flex; gap:8px; margin-top:12px;">
          {
            Array(4)
              .fill(null)
              .map(() => (
                <div
                  class="sk"
                  style="width:32px; height:32px; border-radius:8px;"
                />
