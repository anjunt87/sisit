---
// src/components/landing/PageSkeleton.astro
// Skeleton loading screen — mirrors the active sections in index.astro:
// Hero, News, Facilities, Testimonial, SchoolCalendar, Faq, SchoolLocation,
// Partnership, Contact, Footer
---

<style>
  @keyframes shimmer {
    0% {
      background-position: -800px 0;
    }
    100% {
      background-position: 800px 0;
    }
  }

  .sk-wrap {
    display: none; /* hidden once real page hydrates */
    font-family: "Plus Jakarta Sans", sans-serif;
    background: #f9fafb;
    overflow: hidden;
  }

  /* Show skeleton while JS is loading / before hydration */
  .sk-wrap.visible {
    display: block;
  }

  /* ── shimmer atom ───────────────────────────────────────── */
  .sk {
    background: linear-gradient(90deg, #e5e7eb 0%, #f3f4f6 40%, #e5e7eb 80%);
    background-size: 800px 100%;
    animation: shimmer 1.7s infinite linear;
    border-radius: 6px;
    flex-shrink: 0;
  }

  /* ── helpers ────────────────────────────────────────────── */
  .sk-section {
    padding: 4rem 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  .sk-section-full {
    padding: 4rem 1.5rem;
  }
  .sk-label {
    display: block;
    width: 120px;
    height: 11px;
    margin: 0 auto 12px;
  }
  .sk-heading {
    display: block;
    width: 280px;
    height: 32px;
    margin: 0 auto 8px;
  }
  .sk-heading-left {
    display: block;
    width: 260px;
    height: 28px;
    margin-bottom: 8px;
  }
  .sk-subheading {
    display: block;
    width: 380px;
    height: 16px;
    margin: 0 auto 40px;
  }
  .sk-divider {
    height: 1px;
    background: #e5e7eb;
    margin: 0 0 40px;
  }

  /* ── HERO ───────────────────────────────────────────────── */
  .sk-hero {
    height: 100vh;
    min-height: 600px;
    background: #ffffff;
    position: relative;
    display: flex;
    align-items: center;
    padding: 0 6vw;
  }

  .sk-hero .sk {
    background: linear-gradient(90deg, #e5e7eb 0%, #f3f4f6 40%, #e5e7eb 80%);
    background-size: 800px 100%;
  }

  .sk-hero-badge {
    width: 180px;
    height: 30px;
    border-radius: 20px;
    margin-bottom: 20px;
  }
  .sk-hero-title1 {
    width: min(520px, 80vw);
    height: 56px;
    margin-bottom: 12px;
    border-radius: 8px;
  }
  .sk-hero-title2 {
    width: min(380px, 65vw);
    height: 56px;
    margin-bottom: 24px;
    border-radius: 8px;
  }
  .sk-hero-desc1 {
    width: min(480px, 80vw);
    height: 14px;
    margin-bottom: 10px;
  }
  .sk-hero-desc2 {
    width: min(400px, 70vw);
    height: 14px;
    margin-bottom: 10px;
  }
  .sk-hero-desc3 {
    width: min(300px, 55vw);
    height: 14px;
    margin-bottom: 32px;
  }
  .sk-hero-btn1 {
    width: 160px;
    height: 44px;
    border-radius: 12px;
    margin-right: 12px;
  }
  .sk-hero-btn2 {
    width: 160px;
    height: 44px;
    border-radius: 12px;
  }

  /* dot nav */
  .sk-hero-dots {
    position: absolute;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .sk-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .sk-dot.wide {
    width: 24px;
    border-radius: 4px;
  }

  /* right nav */
  .sk-hero-nav {
    position: absolute;
    right: 24px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .sk-rnav-btn {
    width: 32px;
    height: 36px;
    border-radius: 8px;
  }

  /* ── NAVBAR ─────────────────────────────────────────────── */
  .sk-navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: 64px;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(12px);
    display: flex;
    align-items: center;
    padding: 0 6vw;
    gap: 16px;
    border-bottom: 1px solid #e5e7eb;
  }
  .sk-logo {
    width: 36px;
    height: 36px;
    border-radius: 8px;
  }
  .sk-brand {
    width: 120px;
    height: 16px;
    margin-left: 4px;
  }
  .sk-nav-links {
    display: flex;
    gap: 24px;
    margin-left: auto;
  }
  .sk-nav-link {
    width: 60px;
    height: 12px;
  }
  .sk-nav-btn {
    width: 100px;
    height: 36px;
    border-radius: 8px;
    margin-left: 8px;
  }

  /* ── NEWS ───────────────────────────────────────────────── */
  .sk-news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
    margin-top: 0;
  }
  .sk-news-card {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    overflow: hidden;
  }
  .sk-news-card,
  .sk-testi-card,
  .sk-cal-card,
  .sk-faq-item {
    border: 1px solid #e5e7eb;
  }
  .sk-news-img {
    height: 180px;
    border-radius: 0;
  }
  .sk-news-body {
    padding: 16px;
  }
  .sk-news-tag {
    width: 70px;
    height: 20px;
    border-radius: 20px;
    margin-bottom: 10px;
  }
  .sk-news-t1 {
    height: 15px;
    width: 90%;
    margin-bottom: 7px;
  }
  .sk-news-t2 {
    height: 15px;
    width: 70%;
    margin-bottom: 14px;
  }
  .sk-news-meta {
    height: 11px;
    width: 50%;
  }

  /* ── FACILITIES ─────────────────────────────────────────── */
  .sk-fac-bg {
    background: #f9fafb;
    padding: 5rem 0;
  }
  .sk-fac-bg .sk {
    background: linear-gradient(90deg, #e5e7eb 0%, #f3f4f6 40%, #e5e7eb 80%);
    background-size: 800px 100%;
  }
  .sk-fac-bg .sk-label,
  .sk-fac-bg .sk-heading,
  .sk-fac-bg .sk-subheading {
    background: inherit;
  }
  .sk-fac-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .sk-fac-card {
    height: 220px;
    border-radius: 16px;
  }

  /* ── TESTIMONIALS ───────────────────────────────────────── */
  .sk-testi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }
  .sk-testi-card {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    padding: 24px;
  }
  .sk-stars {
    width: 90px;
    height: 14px;
    margin-bottom: 14px;
  }
  .sk-quote1 {
    height: 13px;
    width: 100%;
    margin-bottom: 8px;
  }
  .sk-quote2 {
    height: 13px;
    width: 85%;
    margin-bottom: 8px;
  }
  .sk-quote3 {
    height: 13px;
    width: 65%;
    margin-bottom: 20px;
  }
  .sk-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
  }
  .sk-tname {
    width: 120px;
    height: 13px;
    margin-bottom: 5px;
    margin-left: 12px;
  }
  .sk-trole {
    width: 80px;
    height: 10px;
    margin-left: 12px;
  }

  /* ── CALENDAR ───────────────────────────────────────────── */
  .sk-cal-wrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 0;
  }
  @media (max-width: 768px) {
    .sk-cal-wrap {
      grid-template-columns: 1fr;
    }
  }
  .sk-cal-card {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    padding: 24px;
  }
  .sk-cal-header {
    height: 20px;
    width: 140px;
    margin-bottom: 20px;
  }
  .sk-cal-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 6px;
    margin-bottom: 16px;
  }
  .sk-cal-day {
    height: 30px;
    border-radius: 6px;
  }
  .sk-event-row {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-bottom: 10px;
  }
  .sk-event-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .sk-event-text {
    flex: 1;
    height: 11px;
  }

  /* ── FAQ ────────────────────────────────────────────────── */
  .sk-faq-list {
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .sk-faq-item {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 18px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .sk-faq-q {
    flex: 1;
    height: 14px;
  }
  .sk-faq-ic {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* ── LOCATION ───────────────────────────────────────────── */
  .sk-loc-wrap {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 28px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .sk-loc-wrap {
      grid-template-columns: 1fr;
    }
  }
  .sk-loc-map {
    height: 340px;
    border-radius: 16px;
  }
  .sk-loc-info {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .sk-loc-row {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .sk-loc-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    flex-shrink: 0;
  }
  .sk-loc-t1 {
    height: 13px;
    width: 200px;
    margin-bottom: 6px;
  }
  .sk-loc-t2 {
    height: 11px;
    width: 150px;
  }

  /* ── PARTNERSHIP ────────────────────────────────────────── */
  .sk-partner-bg {
    background: #f9fafb;
    padding: 4rem 1.5rem;
  }
  .sk-partner-logos {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
    max-width: 1000px;
    margin: 0 auto;
  }
  .sk-partner-logo {
    width: 140px;
    height: 60px;
    border-radius: 10px;
  }

  /* ── CONTACT ────────────────────────────────────────────── */
  .sk-contact-wrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    max-width: 1000px;
    margin: 0 auto;
  }
  @media (max-width: 768px) {
    .sk-contact-wrap {
      grid-template-columns: 1fr;
    }
  }
  .sk-contact-side {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .sk-field {
    height: 44px;
    border-radius: 10px;
    width: 100%;
  }
  .sk-field-t {
    height: 110px;
    border-radius: 10px;
    width: 100%;
  }
  .sk-contact-info {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .sk-ci-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    flex-shrink: 0;
  }
  .sk-ci-t1 {
    height: 13px;
    width: 160px;
    margin-bottom: 5px;
  }
  .sk-ci-t2 {
    height: 11px;
    width: 120px;
  }

  /* ── FOOTER ─────────────────────────────────────────────── */
  .sk-footer {
    background: #f9fafb;
    padding: 3rem 6vw 2rem;
  }
  .sk-footer .sk {
    background: linear-gradient(90deg, #e5e7eb 0%, #f9fafb 40%, #e5e7eb 80%);
    background-size: 800px 100%;
  }
  .sk-footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 32px;
    margin-bottom: 32px;
  }
  @media (max-width: 768px) {
    .sk-footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .sk-footer-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .sk-ft1 {
    height: 14px;
  }
  .sk-ft2 {
    height: 11px;
  }
  .sk-footer-bottom {
    border-top: 1px solid #e5e7eb;
    padding-top: 20px;
    display: flex;
    gap: 16px;
    justify-content: space-between;
  }
  .sk-fb-t {
    height: 11px;
    width: 200px;
  }
</style>

<div
  class="sk-wrap visible"
  id="page-skeleton"
  aria-hidden="true"
>
  <!-- NAVBAR -->
  <div class="sk-navbar">
    <div class="sk sk-logo"></div>
    <div class="sk sk-brand"></div>
    <div
      class="sk-nav-links"
      style="display:flex"
    >
      <div class="sk sk-nav-link"></div>
      <div class="sk sk-nav-link"></div>
      <div class="sk sk-nav-link"></div>
      <div class="sk sk-nav-link"></div>
      <div class="sk sk-nav-link"></div>
    </div>
    <div class="sk sk-nav-btn"></div>
  </div>

  <!-- HERO -->
  <div class="sk-hero">
    <div>
      <div class="sk sk-hero-badge"></div>
      <div class="sk sk-hero-title1"></div>
      <div class="sk sk-hero-title2"></div>
      <div class="sk sk-hero-desc1"></div>
      <div class="sk sk-hero-desc2"></div>
      <div class="sk sk-hero-desc3"></div>
      <div style="display:flex; flex-wrap:wrap;">
        <div class="sk sk-hero-btn1"></div>
        <div class="sk sk-hero-btn2"></div>
      </div>
    </div>
    <!-- right nav pills -->
    <div
      class="sk-hero-nav"
      style="display:flex"
    >
      <div class="sk sk-rnav-btn"></div>
      <div class="sk sk-rnav-btn"></div>
      <div class="sk sk-rnav-btn"></div>
      <div class="sk sk-rnav-btn"></div>
    </div>
    <!-- dot nav -->
    <div class="sk-hero-dots">
      <div class="sk sk-dot wide"></div>
      <div class="sk sk-dot"></div>
      <div class="sk sk-dot"></div>
      <div class="sk sk-dot"></div>
    </div>
  </div>

  <!-- NEWS -->
  <div style="background:#f9fafb; padding:5rem 0;">
    <div
      class="sk-section"
      style="padding-top:0; padding-bottom:0;"
    >
      <div class="sk sk-label"></div>
      <div class="sk sk-heading"></div>
      <div class="sk sk-subheading"></div>
      <div class="sk-news-grid">
        {
          Array(3)
            .fill(null)
            .map(() => (
              <div class="sk-news-card">
                <div class="sk sk-news-img" />
                <div class="sk-news-body">
                  <div class="sk sk-news-tag" />
                  <div class="sk sk-news-t1" />
                  <div class="sk sk-news-t2" />
                  <div class="sk sk-news-meta" />
                </div>
              </div>
            ))
        }
      </div>
    </div>
  </div>

  <!-- FACILITIES -->
  <div class="sk-fac-bg">
    <div style="max-width:1200px; margin:0 auto; padding:0 1.5rem 2.5rem;">
      <div
        class="sk sk-label"
        style="width:100px; height:11px; margin-bottom:12px; display:block;"
      >
      </div>
      <div
        class="sk sk-heading"
        style="width:280px; height:32px; margin-bottom:8px; display:block;"
      >
      </div>
      <div
        class="sk sk-subheading"
        style="width:380px; height:16px; margin-bottom:40px; display:block;"
      >
      </div>
    </div>
    <div class="sk-fac-grid">
      {
        Array(6)
          .fill(null)
          .map(() => <div class="sk sk-fac-card" />)
      }
    </div>
  </div>

  <!-- TESTIMONIALS -->
  <div style="background:#f9fafb; padding:5rem 0;">
    <div
      class="sk-section"
      style="padding-top:0; padding-bottom:0;"
    >
      <div class="sk sk-label"></div>
      <div class="sk sk-heading"></div>
      <div class="sk sk-subheading"></div>
      <div class="sk-testi-grid">
        {
          Array(3)
            .fill(null)
            .map(() => (
              <div class="sk-testi-card">
                <div class="sk sk-stars" />
                <div class="sk sk-quote1" />
                <div class="sk sk-quote2" />
                <div class="sk sk-quote3" />
                <div style="display:flex; align-items:center;">
                  <div class="sk sk-avatar" />
                  <div style="flex:1">
                    <div class="sk sk-tname" />
                    <div class="sk sk-trole" />
                  </div>
                </div>
              </div>
            ))
        }
      </div>
    </div>
  </div>

  <!-- SCHOOL CALENDAR -->
  <div style="background:#fff; padding:5rem 0;">
    <div
      class="sk-section"
      style="padding-top:0; padding-bottom:0;"
    >
      <div class="sk sk-label"></div>
      <div class="sk sk-heading"></div>
      <div class="sk sk-subheading"></div>
      <div class="sk-cal-wrap">
        <!-- mini calendar -->
        <div class="sk-cal-card">
          <div class="sk sk-cal-header"></div>
          <div class="sk-cal-grid">
            {
              Array(35)
                .fill(null)
                .map(() => <div class="sk sk-cal-day" />)
            }
          </div>
        </div>
        <!-- event list -->
        <div class="sk-cal-card">
          <div
            class="sk sk-cal-header"
            style="width:180px; margin-bottom:20px;"
          >
          </div>
          {
            Array(5)
              .fill(null)
              .map(() => (
                <div class="sk-event-row">
                  <div class="sk sk-event-dot" />
                  <div class="sk sk-event-text" />
                </div>
              ))
          }
        </div>
      </div>
    </div>
  </div>

  <!-- FAQ -->
  <div style="background:#f9fafb; padding:5rem 0;">
    <div
      class="sk-section"
      style="padding-top:0; padding-bottom:0;"
    >
      <div class="sk sk-label"></div>
      <div class="sk sk-heading"></div>
      <div class="sk sk-subheading"></div>
      <div class="sk-faq-list">
        {
          Array(6)
            .fill(null)
            .map(() => (
              <div class="sk-faq-item">
                <div class="sk sk-faq-q" />
                <div class="sk sk-faq-ic" />
              </div>
            ))
        }
      </div>
    </div>
  </div>

  <!-- SCHOOL LOCATION -->
  <div style="background:#fff; padding:5rem 0;">
    <div
      class="sk-section"
      style="padding-top:0; padding-bottom:0;"
    >
      <div class="sk sk-label"></div>
      <div class="sk sk-heading"></div>
      <div class="sk sk-subheading"></div>
      <div class="sk-loc-wrap">
        <div>
          <div class="sk sk-loc-map"></div>
        </div>
        <div class="sk-loc-info">
          {
            Array(4)
              .fill(null)
              .map(() => (
                <div class="sk-loc-row">
                  <div class="sk sk-loc-icon" />
                  <div>
                    <div class="sk sk-loc-t1" />
                    <div class="sk sk-loc-t2" />
                  </div>
                </div>
              ))
          }
          <div
            class="sk"
            style="height:44px; width:160px; border-radius:10px; margin-top:8px;"
          >
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- PARTNERSHIP -->
  <div class="sk-partner-bg">
    <div
      class="sk sk-label"
      style="display:block; margin:0 auto 12px;"
    >
    </div>
    <div
      class="sk sk-heading"
      style="display:block; margin:0 auto 8px;"
    >
    </div>
    <div
      class="sk sk-subheading"
      style="display:block; margin:0 auto 36px;"
    >
    </div>
    <div class="sk-partner-logos">
      {
        Array(8)
          .fill(null)
          .map(() => <div class="sk sk-partner-logo" />)
      }
    </div>
  </div>

  <!-- CONTACT -->
  <div style="background:#f9fafb; padding:5rem 0;">
    <div
      class="sk-section"
      style="padding-top:0; padding-bottom:0;"
    >
      <div class="sk sk-label"></div>
      <div class="sk sk-heading"></div>
      <div class="sk sk-subheading"></div>
      <div class="sk-contact-wrap">
        <!-- form side -->
        <div class="sk-contact-side">
          <div class="sk sk-field"></div>
          <div class="sk sk-field"></div>
          <div class="sk sk-field"></div>
          <div class="sk sk-field-t"></div>
          <div
            class="sk"
            style="height:44px; width:140px; border-radius:10px;"
          >
          </div>
        </div>
        <!-- info side -->
        <div class="sk-contact-side">
          {
            Array(4)
              .fill(null)
              .map(() => (
                <div class="sk-contact-info">
                  <div class="sk sk-ci-icon" />
                  <div>
                    <div class="sk sk-ci-t1" />
                    <div class="sk sk-ci-t2" />
                  </div>
                </div>
              ))
          }
        </div>
      </div>
    </div>
  </div>

  <!-- FOOTER -->
  <div class="sk-footer">
    <div class="sk-footer-grid">
      <!-- brand col -->
      <div class="sk-footer-col">
        <div
          style="display:flex; gap:10px; align-items:center; margin-bottom:8px;"
        >
          <div
            class="sk"
            style="width:40px; height:40px; border-radius:8px;"
          >
          </div>
          <div
            class="sk sk-ft1"
            style="width:140px;"
          >
          </div>
        </div>
        <div
