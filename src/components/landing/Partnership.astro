---
// src/components/landing/Partnership.astro

import logoUIN from "../../assets/images/partnership/logo-UIN.png";
import logoUI from "../../assets/images/partnership/logo-UI.png";
import logoMUI from "../../assets/images/partnership/logo-MUI.png";
import logoBaznas from "../../assets/images/partnership/logo-baznas.png";
import logoRumahTahfidz from "../../assets/images/partnership/logo-rumah-tahfidz.png";
import logoODOJ from "../../assets/images/partnership/logo-odoj-karawang.png";
import logoUMMI from "../../assets/images/partnership/logo-UMMI.png";

const partners = [
  { name: "UIN SGD Bandung", logo: logoUIN },
  { name: "Universitas Islam Indonesia", logo: logoUI },
  { name: "Majelis Ulama Indonesia", logo: logoMUI },
  { name: "BAZNAS", logo: logoBaznas },
  { name: "Rumah Tahfidz", logo: logoRumahTahfidz },
  { name: "ODOJ Karawang", logo: logoODOJ },
  { name: "UMMI", logo: logoUMMI },
];
---

<!-- Ganti bagian Swiper dengan ini -->
<section class="py-14 bg-gradient-to-br from-blue-50 to-green-50 px-6">
  <div class="max-w-5xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-12">
      <span
        data-animate="fade-up"
        data-delay="100"
        class="inline-block bg-green-600 text-white px-5 py-2 rounded-full text-sm font-semibold mb-4 shadow-md"
      >
        Kerja Sama
      </span>
      <h2
        data-animate="fade-up"
        data-delay="200"
        class="text-4xl md:text-5xl font-bold mb-6 text-gray-800"
      >
        Partnership <span class="text-green-600">Strategis</span>
      </h2>
      <p
        data-animate="fade-up"
        data-delay="300"
        class="text-gray-600 max-w-xl mx-auto"
      >
        Kami menjalin kemitraan dengan lembaga keislaman dan universitas
        terkemuka untuk mendukung pengembangan pendidikan Islami berkualitas.
      </p>
    </div>

    <!-- Marquee Track -->
    <div class="marquee-wrapper overflow-hidden relative">
      <!-- Fade edges -->
      <div
        class="pointer-events-none absolute left-0 top-0 h-full w-24 z-10 bg-gradient-to-r from-blue-50/80 to-transparent"
      >
      </div>
      <div
        class="pointer-events-none absolute right-0 top-0 h-full w-24 z-10 bg-gradient-to-l from-green-50/80 to-transparent"
      >
      </div>

      <div
        class="marquee-track flex gap-5"
        style="width: max-content;"
      >
        <!-- Render 2x untuk loop seamless -->
        {
          [...partners, ...partners].map((item, i) => (
            <div
              class="partner-card bg-white border border-green-100 rounded-2xl px-7 py-5 flex flex-col items-center justify-center gap-3 shadow-sm hover:shadow-md hover:border-green-300 transition-all duration-300 group"
              style="min-width: 160px; height: 120px;"
            >
              <img
                src={item.logo.src}
                alt={item.name}
                class="h-10 object-contain grayscale group-hover:grayscale-0 transition-all duration-500 group-hover:scale-110"
              />
              <span class="text-[11px] font-medium text-gray-400 group-hover:text-green-600 transition-colors duration-300 text-center leading-tight">
                {item.name}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .marquee-track {
    animation: marquee-scroll 28s linear infinite;
  }

  .marquee-wrapper:hover .marquee-track {
    animation-play-state: paused;
  }

  @keyframes marquee-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .partner-card {
    flex-shrink: 0;
  }
</style>

<!-- Import Swiper CSS & JS dari CDN -->
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
/>
<script
  src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"
  is:inline
>
</script>
<script>
  import Swiper from "swiper";
  import { Autoplay, Pagination } from "swiper/modules";

  let swiper = null;

  function init() {
    if (swiper) {
      swiper.destroy(true, true);
      swiper = null;
    }
    const el = document.querySelector(".kerja-sama-swiper");
    if (!el) return;
    swiper = new Swiper(".kerja-sama-swiper", {
      modules: [Autoplay, Pagination],
      slidesPerView: 2,
      spaceBetween: 20,
      loop: true,
      autoplay: { delay: 2500, disableOnInteraction: false },
      pagination: {
        el: ".kerja-sama-swiper .swiper-pagination",
        clickable: true,
      },
      breakpoints: {
        640: { slidesPerView: 3 },
        768: { slidesPerView: 4 },
        1024: { slidesPerView: 5 },
      },
    });
  }

  init();
  document.addEventListener("astro:after-swap", init);
  document.addEventListener("astro:before-swap", () => {
    if (swiper) {
      swiper.destroy(true, true);
      swiper = null;
    }
  });
</script>
