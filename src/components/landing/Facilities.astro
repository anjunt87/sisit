---
// src/components/landing/Facilities.astro
// Struktur data diasumsikan dari ../../data/facilities
// Pisahkan menjadi featured (6) dan supporting (sisanya)

import { facilities } from "../../data/facilities";

import "../../styles/facilities.css";

// 6 pertama = fasilitas unggulan, sisanya = pendukung
const featured = facilities.slice(0, 6);
const supporting = facilities.slice(6);
const hasSupporting = supporting.length > 0;
---

<section id="facilities" class="fac-section">
  <!-- Dekorasi background -->
  <div class="fac-bg" aria-hidden="true"></div>
  <div class="fac-orb fac-orb--1" aria-hidden="true"></div>
  <div class="fac-orb fac-orb--2" aria-hidden="true"></div>

  <div class="fac-container">

    <!-- ── Header ── -->
    <div class="fac-header" data-aos="fade-up">
      <span class="fac-badge">
        <span class="fac-badge-dot"></span>
        Fasilitas
      </span>
      <h2 class="fac-title">
        Fasilitas <em>Unggulan</em>
      </h2>
      <p class="fac-subtitle">
        Sarana dan prasarana modern untuk mendukung proses belajar mengajar
        yang optimal dan menyenangkan.
      </p>
    </div>

    <!-- ── Grid Utama (6 fasilitas featured) ── -->
    <div class="fac-grid" data-aos="fade-up" data-aos-delay="100">
      {featured.map((item, i) => (
        <article
          class="fac-card"
          style={`--delay: ${i * 60}ms`}
          data-aos="fade-up"
          data-aos-delay={100 + i * 60}
        >
          <!-- Icon block -->
          <div class={`fac-icon-wrap ${item.bg}`}>
            <i class={`${item.icon} fac-icon ${item.color}`} aria-hidden="true"></i>
          </div>

          <!-- Content -->
          <div class="fac-card-body">
            <h3 class="fac-card-title">{item.title}</h3>
            <p class="fac-card-desc">{item.desc}</p>
          </div>

          <!-- Accent corner -->
          <div class="fac-card-corner" aria-hidden="true"></div>
        </article>
      ))}
    </div>

    <!-- ── Fasilitas Pendukung ── -->
    {hasSupporting && (
      <div class="fac-supporting" data-aos="fade-up" data-aos-delay="300">
        <p class="fac-supporting-label">Fasilitas Pendukung</p>
        <div class="fac-pill-grid">
          {supporting.map((item) => (
            <div class="fac-pill">
              <i class={`${item.icon} fac-pill-icon ${item.color}`} aria-hidden="true"></i>
              <span>{item.title}</span>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- ── CTA ── -->
    <div class="fac-cta" data-aos="fade-up" data-aos-delay="350">
      <a href="/tentang#fasilitas" class="fac-cta-btn">
        Lihat Detail Lengkap
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4"/>
        </svg>
      </a>
    </div>

  </div>
</section>
