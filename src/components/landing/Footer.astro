---
import logo from "../../assets/images/logo-niis-putih.png";
import FloatingButtons from "../ui/FloatingButtons.astro";
import Chatbot from "../ui/Chatbot.astro";
import "../../styles/footer.css";
---

<footer class="bg-gray-900 text-white py-16">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid lg:grid-cols-4 md:grid-cols-2 gap-8">
      <!-- Kolom 1: Logo -->
      <div
        data-animate="fade-up"
        data-delay="100"
      >
        <img
          src={logo.src}
          alt="Logo NIIS"
          class="w-32 mb-6"
        />
        <p class="text-gray-400 mb-6">
          Menjadi lembaga pendidikan rujukan yang membentuk generasi rabbani.
        </p>
        <div class="flex gap-3">
          <a
            href="#"
            class="footer-social"
          >
            <i class="fab fa-facebook-f"></i>
          </a>
          <a
            href="#"
            class="footer-social"
          >
            <i class="fab fa-instagram"></i>
          </a>
          <a
            href="#"
            class="footer-social"
          >
            <i class="fab fa-youtube"></i>
          </a>
          <a
            href="#"
            class="footer-social"
          >
            <i class="fab fa-whatsapp"></i>
          </a>
        </div>
      </div>

      <!-- Kolom 2 -->
      <div
        data-animate="fade-up"
        data-delay="200"
      >
        <h4 class="footer-title">Program Pendidikan</h4>
        <ul class="footer-links">
          <li><a href="#">KB / TK IT</a></li>
          <li><a href="#">SD IT</a></li>
          <li><a href="#">SMP IT</a></li>
          <li><a href="#">SMA IT</a></li>
          <li><a href="#">Tahfidz</a></li>
        </ul>
      </div>

      <!-- Kolom 3 -->
      <div
        data-animate="fade-up"
        data-delay="300"
      >
        <h4 class="footer-title">Informasi</h4>
        <ul class="footer-links">
          <li><a href="#">Tentang Kami</a></li>
          <li><a href="#">Visi Misi</a></li>
          <li><a href="#">Prestasi</a></li>
          <li><a href="#">Berita</a></li>
          <li><a href="#">Event</a></li>
        </ul>
      </div>

      <!-- Kolom 4 -->
      <div
        data-animate="fade-up"
        data-delay="400"
      >
        <h4 class="footer-title">Kontak</h4>
        <div class="space-y-4 text-gray-400 text-sm">
          <div class="flex gap-3">
            <i class="fas fa-map-marker-alt text-green-500 mt-1"></i>
            <span>Jl. Manunggal XIX, Pasirjengkol, Majalaya, Karawang</span>
          </div>
          <div class="flex gap-3">
            <i class="fas fa-phone text-green-500"></i>
            <span>0812-8215-9719</span>
          </div>
          <div class="flex gap-3">
            <i class="fas fa-envelope text-green-500"></i>
            <span>info@nurulimam.sch.id</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      data-animate="fade"
      data-delay="300"
      class="border-t border-gray-800 mt-12 pt-8 flex flex-col md:flex-row justify-between items-center gap-4"
    >
      <p class="text-gray-400 text-sm">
        © 2026 Nurul Imam Islamic School. All Rights Reserved.
      </p>
      <div class="flex gap-5 text-sm text-gray-400">
        <a href="#">Privacy Policy</a>
        <a href="#">Terms</a>
      </div>
    </div>
  </div>
</footer>
