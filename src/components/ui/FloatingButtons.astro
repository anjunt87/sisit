---
// Chatbot.astro — no props needed
---

<!-- Back to top -->
<button
  id="backToTop"
  type="button"
  class="fixed bottom-44 right-4 z-50 w-12 h-12 bg-white/20 rounded-full shadow-xl backdrop-blur-md flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-500"
  style="color: var(--color-primary)"
>
  <i class="fas fa-chevron-up text-xl"></i>
</button>

<!-- WhatsApp -->
<div class="fixed bottom-6 right-4 z-40">
  <a
    href="https://wa.me/628123456789"
    target="_blank"
    rel="noopener noreferrer"
    class="w-12 h-12 bg-white/20 rounded-full flex items-center justify-center shadow-xl backdrop-blur-md hover:scale-110 transition-all"
    style="color: var(--color-primary)"
  >
    <i class="fab fa-whatsapp text-xl"></i>
  </a>
</div>
