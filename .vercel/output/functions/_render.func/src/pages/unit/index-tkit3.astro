---
// src/pages/unit/tkit3.astro

import BaseLayout from "../../layouts/BaseLayout.astro";

import {
  identitas,
  stats,
  statistik,
  prosesPembelajaran,
  // milestones,
  pimpinan,
  gallery,
  categories,
} from "../../data/tkit3";

// section components
import Hero from "./tkit3/Hero.astro";
import Stats from "./tkit3/Stats.astro";
import Tentang from "./tkit3/Tentang.astro";
import Pimpinan from "./tkit3/Pimpinan.astro";
import Keunggulan from "./tkit3/Keunggulan.astro";
import Visimisi from "./tkit3/Visimisi.astro";
import Kompetensi from "./tkit3/Kompetensi.astro";
import Ekskul from "./tkit3/Ekskul.astro";
import Gallery from "./tkit3/Gallery.astro";
import Statistik from "./tkit3/Statistik.astro";
import Identitas from "./tkit3/Identitas.astro";
import CTA from "./tkit3/CTA.astro";
---

<BaseLayout
  title="Profil TKIT Nurul Imam Karawang 1"
  description="Profil lengkap TKIT Nurul Imam 3 Karawang, sekolah dasar Islam terpadu dengan akreditasi A, kurikulum merdeka dan pembelajaran full day school."
  theme="orange"
>
  <Hero />

  <Stats stats={stats} />

  <Tentang />

  <Pimpinan pimpinan={pimpinan} />

  <Keunggulan />

  <Visimisi />

  <Kompetensi />

  <Gallery
    gallery={gallery}
    categories={categories}
  />

  <Statistik
    statistik={statistik}
    proses={prosesPembelajaran}
  />

  <Identitas identitas={identitas} />

  <CTA />
</BaseLayout>
