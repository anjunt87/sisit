---
import { identitas } from "../../../data/smpit";
---

<!-- ╔══════════════════════════════════════╗ --><!-- ║          IDENTITAS SEKOLAH          ║ --><!-- ╚══════════════════════════════════════╝ -->
<section class="py-20 bg-slate-50">
  <div class="max-w-5xl mx-auto px-6">
    <div class="text-center mb-12">
      <span
        data-animate="fade-up"
        data-delay="100"
        class="inline-block bg-sky-100 text-sky-600 px-4 py-2 rounded-full text-sm font-semibold mb-4"
      >
        Identitas
      </span>
      <h2
        data-animate="fade-up"
        data-delay="200"
        class="text-4xl md:text-5xl font-bold text-gray-800"
      >
        Identitas <span class="text-sky-600">SMPIT Bilingual Nurul Imam</span>
      </h2>
    </div>

    <div
      data-animate="fade-up"
      data-delay="300"
      class="relative bg-white rounded-3xl border border-slate-200 overflow-hidden shadow-sm"
    >
      <div
        class="absolute top-0 right-0 w-48 h-48 pointer-events-none overflow-hidden"
      >
        <div
          class="absolute w-36 h-36 -top-14 -right-14 bg-sky-50 rounded-full"
        >
        </div>
        <div class="absolute w-20 h-20 top-5 right-5 bg-sky-100 rounded-full">
        </div>
      </div>

      <div class="relative divide-y divide-slate-100">
        {
          identitas.map((row) => (
            <div class="grid grid-cols-[180px_1fr] sm:grid-cols-[220px_1fr] px-6 sm:px-8 py-4 hover:bg-sky-50 transition">
              <div class="flex items-center gap-2.5 text-sm font-semibold text-slate-500">
                <i class={`fas ${row.icon} text-sky-600 w-4`} />
                {row.label}
              </div>
              <div class="text-sm text-slate-700 font-medium leading-relaxed">
                {row.value}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
